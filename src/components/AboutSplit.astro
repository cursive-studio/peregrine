---
import Container from "./Container.astro";

interface Props {
  thumbnailImage?: string;
}

const {
  thumbnailImage = "https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?auto=format&fit=crop&w=640&q=80",
} = Astro.props;
---

<section id="about" class="py-24 md:py-32" aria-labelledby="about-heading">
  <Container>
    <!-- Eyebrow -->
    <p class="mb-16 text-[11px] font-medium  text-neutral-400 uppercase md:mb-20">
      About Us
    </p>

    <div class="grid gap-12 md:grid-cols-12 md:gap-8">
      <!-- Left column: copy -->
      <div class="md:col-span-7 lg:col-span-10">
        <h2 id="about-heading" class="text-2xl leading-normal tracking-tight font-medium text-neutral-800 md:text-3xl md:leading-relaxed">
          <span class="font-semibold text-neutral-900">Peregrine Creative Group</span> is a
          design-led manufacturing and distribution partner with over 30&nbsp;years of combined
          experience. We work alongside ambitious brands to develop, produce, and ship sustainable
          products that look as good as they perform.
        </h2>
      </div>

      <!-- Right column: thumbnail -->
      <div class="flex items-start justify-end md:col-span-5 lg:col-span-5 lg:col-start-9">
        <!-- <img
          src={thumbnailImage}
          alt="Peregrine Creative workspace"
          class="aspect-[4/3] w-full max-w-sm rounded-xl object-cover md:max-w-none"
          loading="lazy"
        /> -->
      </div>
    </div>
  </Container>
</section>
