---
import Container from "./Container.astro";

interface Props {
  thumbnailImage?: string;
}

const {
  thumbnailImage = "https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?auto=format&fit=crop&w=640&q=80",
} = Astro.props;
---

<section id="about" class="py-32 md:py-44" aria-labelledby="about-heading">
  <Container>
    <div class="grid items-start gap-16 md:grid-cols-12 md:gap-20">
      <!-- Statement text — large editorial paragraph -->
      <div class="md:col-span-8">
        <p class="mb-10 text-xs font-medium tracking-[0.15em] text-neutral-400 uppercase">
          About
        </p>
        <h2 id="about-heading" class="text-2xl leading-[1.4] font-light text-neutral-600 md:text-3xl lg:text-[2.5rem] lg:leading-[1.35]">
          <span class="font-medium text-neutral-900">Peregrine Creative Group</span> develops and distributes
          sustainable products across reusable packaging, garment manufacturing, and consumer goods — connecting
          design, production, and supply into a single operating system.
        </h2>
      </div>

      <!-- Small image accent -->
      <div class="hidden md:col-span-3 md:col-start-10 md:block">
        <img
          src={thumbnailImage}
          alt="Peregrine Creative operations"
          class="aspect-[3/4] w-full rounded-2xl object-cover"
          loading="lazy"
        />
      </div>
    </div>
  </Container>
</section>
