---
interface Props {
  thumbnailImage?: string;
}

const {
  thumbnailImage = "https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?auto=format&fit=crop&w=640&q=80",
} = Astro.props;

const logos = [
  { src: "/peregrine-client-logos/frozon-brothers-logo 1.svg", alt: "Frozen Brothers" },
  { src: "/peregrine-client-logos/cola.svg", alt: "Coca-Cola" },
  { src: "/peregrine-client-logos/tango.svg", alt: "Tango" },
  { src: "/peregrine-client-logos/vimto.svg", alt: "Vimto" },
  { src: "/peregrine-client-logos/steri.svg", alt: "Steri Pack" },
  { src: "/peregrine-client-logos/liva-logo.svg", alt: "LIVA" },
  { src: "/peregrine-client-logos/crealy-logo 1.svg", alt: "Crealy" },
  { src: "/peregrine-client-logos/hoburne.svg", alt: "Hoburne" },
  { src: "/peregrine-client-logos/pleasure-beach.svg", alt: "Pleasure Beach" },
  { src: "/peregrine-client-logos/avoryx-logo.png", alt: "Avoryx" },
];

const rail = [...logos, ...logos];
---

<section id="about" class="w-full overflow-x-hidden bg-white px-6 py-28 md:px-12 md:py-40 lg:px-8" aria-labelledby="about-heading">
  <div class="flex flex-col min-w-0 items-start gap-12  md:gap-32">
      <div>
        <h2 id="about-heading" class="max-w-[500px]  font-light tracking-tight text-neutral-600 md:text-base md:leading-[1.16] lg:text-xl">

            Peregrine Creative Group is a design-led manufacturing and distribution partner with over 30 years of combined experience across reusable packaging, garments, and sustainable product supply chains.

        </h2>
      </div>

      <div class="min-w-0 max-w-full md:col-span-7">
        <p class="mb-8 text-[10px] font-medium tracking-[0.2em] text-neutral-400 uppercase">
          Trusted by
        </p>

        <div class="about-marquee relative w-full max-w-full overflow-hidden">
          <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-8 bg-gradient-to-r from-white to-transparent sm:w-10"></div>
          <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-8 bg-gradient-to-l from-white to-transparent sm:w-10"></div>

          <div class="about-marquee-track flex w-max items-center gap-6 sm:gap-8">
            {rail.map((logo) => (
              <div class="flex h-8 w-24 shrink-0 items-center justify-center sm:h-10 sm:w-[7.5rem]">
                <img
                  src={logo.src}
                  alt={logo.alt}
                  class="about-marquee-logo h-full w-full object-contain"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            ))}
          </div>
        </div>
      </div>
  </div>
</section>

<style>
  .about-marquee-track {
    animation: about-logo-marquee 24s linear infinite;
  }

  .about-marquee:hover .about-marquee-track {
    animation-play-state: paused;
  }

  .about-marquee-logo {
    filter: grayscale(1);
  }

  @keyframes about-logo-marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-marquee-track {
      animation: none;
    }
  }
</style>
