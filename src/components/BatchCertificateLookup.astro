---
import '../styles/certificates.css';
---
<div class="certificate-app grid min-w-0 gap-x-20 gap-y-10 lg:grid-cols-2" data-batch-lookup>
  <slot name="intro" />
  <div class="min-w-0 self-center">
    <form id="lookup-form" class="max-w-lg">
      <label for="batch-number">Batch number</label>
      <div class="flex flex-wrap gap-3">
        <input id="batch-number" name="batch" required maxlength="80" autocomplete="off" autocapitalize="characters" spellcheck="false" aria-describedby="batch-help lookup-message" class="min-w-0 flex-[1_1_220px]" />
        <button class="primary" type="submit">Find certificate</button>
      </div>
      <p id="batch-help" class="mt-3 text-sm muted">Use the batch number printed on your bottle.</p>
    </form>
    <p id="lookup-message" class="message max-w-lg" role="status" aria-live="polite" aria-atomic="true"></p>
    <noscript><p class="mt-4 text-sm">Please enable JavaScript to find your certificate, or <a href="mailto:info@peregrinecreativegroup.com" class="underline">contact Peregrine</a> with your batch number.</p></noscript>
    <slot name="help" />
  </div>
  <section id="lookup-result" hidden class="col-span-full min-w-0 border-y border-neutral-200 py-8" aria-label="Batch certificate">
    <h3 id="result-product" class="text-2xl"></h3>
    <p class="mt-3 muted">Batch <strong id="result-batch" class="font-medium text-black"></strong></p>
    <div id="certificate-preview" class="mt-6"></div>
    <a id="result-link" class="action mt-6" download>Download certificate</a>
  </section>
</div>

<script>
  import { apiBase, certificateRequest } from '../lib/certificate-api';

  document.querySelectorAll<HTMLElement>('[data-batch-lookup]').forEach(root => {
    const form = root.querySelector<HTMLFormElement>('form')!;
    const input = root.querySelector<HTMLInputElement>('input')!;
    const button = root.querySelector<HTMLButtonElement>('button')!;
    const message = root.querySelector<HTMLElement>('#lookup-message')!;
    const result = root.querySelector<HTMLElement>('#lookup-result')!;
    const link = root.querySelector<HTMLAnchorElement>('#result-link')!;
    const preview = root.querySelector<HTMLElement>('#certificate-preview')!;
    let requestId = 0;
    let controller: AbortController | undefined;
    let certificateUrl: string | undefined;

    const clearResult = () => {
      result.hidden = true;
      link.removeAttribute('href');
      preview.replaceChildren();
      if (certificateUrl) URL.revokeObjectURL(certificateUrl);
      certificateUrl = undefined;
    };
    input.addEventListener('input', () => {
      requestId++;
      controller?.abort();
      clearResult();
      message.textContent = '';
      button.disabled = false;
      form.removeAttribute('aria-busy');
      input.setCustomValidity('');
    });
    form.addEventListener('submit', async event => {
      event.preventDefault();
      const batchNumber = input.value.trim();
      if (!batchNumber) {
        input.setCustomValidity('Enter the batch number printed on your bottle.');
        input.reportValidity();
        return;
      }
      const current = ++requestId;
      controller?.abort();
      controller = new AbortController();
      const signal = controller.signal;
      button.disabled = true;
      form.setAttribute('aria-busy', 'true');
      clearResult();
      message.textContent = 'Finding your certificate…';
      try {
        const batch = await certificateRequest(`/lookup?batch=${encodeURIComponent(batchNumber)}`, { signal });
        if (current !== requestId) return;
        message.textContent = 'Loading your certificate…';
        const response = await fetch(`${apiBase}/certificate?batch=${encodeURIComponent(batch.batch_number)}`, { signal });
        if (!response.ok) {
          const error = await response.json().catch(() => null);
          throw new Error(error?.error || 'Unable to load your certificate. Please try again.');
        }
        const file = await response.blob();
        if (current !== requestId) return;
        const extensions: Record<string, string> = {
          'image/jpeg': 'jpg', 'image/png': 'png', 'image/webp': 'webp',
          'image/gif': 'gif', 'application/pdf': 'pdf',
        };
        const extension = extensions[file.type];
        if (!extension) throw new Error('This certificate format cannot be displayed. Please contact Peregrine.');
        certificateUrl = URL.createObjectURL(file);
        if (file.type === 'application/pdf') {
          const frame = document.createElement('iframe');
          frame.src = certificateUrl;
          frame.title = `Certificate for batch ${batch.batch_number}`;
          frame.className = 'block h-[70svh] min-h-[420px] w-full rounded border border-neutral-200 bg-white';
          preview.append(frame);
        } else {
          const image = document.createElement('img');
          image.src = certificateUrl;
          image.alt = `Certificate for ${batch.product_name}, batch ${batch.batch_number}`;
          image.className = 'block h-auto w-full rounded border border-neutral-200';
          await image.decode();
          if (current !== requestId) return;
          preview.append(image);
        }
        root.querySelector('#result-product')!.textContent = batch.product_name;
        root.querySelector('#result-batch')!.textContent = batch.batch_number;
        link.href = certificateUrl;
        link.download = `certificate-${batch.batch_number.replace(/[^a-z0-9-]/gi, '-')}.${extension}`;
        result.hidden = false;
        message.textContent = 'Certificate found for your batch.';
      } catch (error) {
        if (current === requestId) {
          clearResult();
          message.textContent = error instanceof Error ? error.message : 'Unable to load your certificate. Please try again.';
        }
      } finally {
        if (current === requestId) {
          button.disabled = false;
          form.removeAttribute('aria-busy');
        }
      }
    });
    const batch = new URLSearchParams(location.search).get('batch');
    if (batch) { input.value = batch; form.requestSubmit(); }
  });
</script>
