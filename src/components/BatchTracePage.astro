---
import BaseLayout from '../layouts/BaseLayout.astro';
import BatchCertificateLookup from './BatchCertificateLookup.astro';
---
<BaseLayout title="Batch Certificates | LIVA Olive Oil" description="Find the certificate for your LIVA olive oil using the batch number on your bottle.">
  <div class="certificate-app">
    <header class="flex items-center justify-between border-b border-neutral-200 px-6 py-6 md:px-12">
      <a href="/" class="text-xl font-medium">Peregrine</a>
      <a href="/liva" class="text-sm">LIVA Olive Oil</a>
    </header>
    <main class="mx-auto min-h-[80svh] max-w-[1440px] px-6 py-20 md:px-12 lg:px-14">
      <BatchCertificateLookup>
        <div slot="intro">
          <p class="mb-6 text-sm muted">LIVA Olive Oil</p>
          <h1 class="mb-6 max-w-xl text-4xl font-medium leading-tight md:text-5xl">Your bottle.<br />Your batch certificate.</h1>
          <p class="max-w-lg text-lg muted">Enter the batch number printed on your bottle to view its certificate.</p>
        </div>
        <p slot="help" class="mt-8 text-sm muted">Need help? <a href="mailto:info@peregrinecreativegroup.com" class="underline">Contact Peregrine</a></p>
      </BatchCertificateLookup>
    </main>
  </div>
</BaseLayout>
