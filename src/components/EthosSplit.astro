---
const values = [
  {
    title: "Right products",
    description:
      "We choose projects where quality, usefulness, and long-term demand can work together.",
  },
  {
    title: "Right partners",
    description:
      "We build with manufacturers, growers, brands, and distributors who care about the outcome.",
  },
  {
    title: "Right process",
    description:
      "We connect sourcing, sampling, production, logistics, and market feedback into one clear system.",
  },
  {
    title: "Right standards",
    description:
      "We keep quality control, responsible materials, and commercial discipline visible from first idea to delivery.",
  },
];
---

<section id="ethos" class="relative min-h-screen w-full overflow-hidden bg-neutral-950 px-6 py-24 text-white md:px-12 md:py-28 lg:px-16" aria-labelledby="ethos-heading">
  <img
    src="/liva/olive-tree.jpg"
    alt="Olive branches in a grove"
    class="absolute inset-0 h-full w-full object-cover"
    loading="lazy"
  />
  <div class="absolute inset-0 bg-black/65"></div>
  <div class="absolute inset-0 bg-gradient-to-r from-black/50 via-black/25 to-black/10"></div>

  <div class="relative z-10 flex min-h-[calc(100vh-12rem)] max-w-5xl flex-col justify-between">
    <div>
      <p class="mb-10 inline-flex bg-white px-4 py-3 text-xs font-medium tracking-[0.12em] text-neutral-700 uppercase">
        How we work
      </p>
      <h2 id="ethos-heading" class="font-serif text-6xl leading-none tracking-tight md:text-8xl">
        Our Ethos
      </h2>
      <p class="mt-12 max-w-2xl text-lg leading-relaxed text-white/80 md:text-xl">
        Every decision we make is guided by a simple operating principle: build products that can travel from idea to market with quality, responsibility, and clarity intact.
      </p>
    </div>

    <div class="mt-16 max-w-4xl divide-y divide-white/20 border-y border-white/20">
      {values.map((item) => (
        <article class="grid gap-4 py-5 md:grid-cols-[0.9fr_1.5fr] md:gap-10">
          <h3 class="font-serif text-3xl leading-tight text-white md:text-4xl">{item.title}</h3>
          <p class="self-center text-base leading-relaxed text-white/75 md:text-lg">{item.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
