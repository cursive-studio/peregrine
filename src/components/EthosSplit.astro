---
import Container from "./Container.astro";

interface Props {
  image?: string;
}

const {
  image = "https://images.unsplash.com/photo-1532601224476-15c79f2f7a51?auto=format&fit=crop&w=1200&q=80",
} = Astro.props;

const values = [
  { text: "Always think outside the box", bold: false },
  { text: "Minimise the impact on the environment", bold: false },
  { text: "High quality does not necessarily mean high price", bold: true },
];
---

<section id="values" class="py-24 md:py-32" aria-labelledby="values-heading">
  <Container>
    <div class="grid gap-12 md:grid-cols-12 md:gap-8">
      <!-- Left content -->
      <div class="flex flex-col justify-center md:col-span-5">
        <!-- Eyebrow -->
        <p class="mb-8 text-[11px] font-medium tracking-[0.2em] text-neutral-400 uppercase">
          Values
        </p>

        <h2 id="values-heading" class="mb-6 text-3xl font-light text-neutral-800 md:text-4xl">
          Our Ethos
        </h2>

        <p class="mb-10 max-w-sm text-sm leading-relaxed text-neutral-500 md:text-base">
          We help brands bring ideas to market — responsibly, efficiently, and at scale.
        </p>

        <!-- Values list -->
        <ul class="divide-y divide-neutral-200" role="list">
          {values.map((item) => (
            <li class="py-4 first:pt-0 last:pb-0">
              <p class:list={[
                "text-sm md:text-base",
                item.bold
                  ? "font-semibold text-neutral-900"
                  : "font-normal text-neutral-600",
              ]}>
                {item.text}
              </p>
            </li>
          ))}
        </ul>
      </div>

      <!-- Right image -->
      <div class="md:col-span-7">
        <img
          src={image}
          alt="Wind turbines representing sustainable values"
          class="aspect-[4/3] w-full rounded-2xl object-cover"
          loading="lazy"
        />
      </div>
    </div>
  </Container>
</section>
