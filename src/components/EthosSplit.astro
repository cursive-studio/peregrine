---
import Container from "./Container.astro";

const values = [
  {
    title: "High quality does not necessarily mean high price",
    description:
      "We do all our productions in-house. We oversee every aspect of the production, from initial 3d draft designs, through to mold creation and final product.",
  },
  {
    title: "Always think outside the box",
    description:
      "We constantly look into new technology and advancements in the industry. Our design team works in tandem with product technicians to push the boundary on what can be achieved.",
  },
  {
    title: "Minimise the impact on the environment",
    description:
      "All our products are comprised of fully recyclable PET plastic. Our reusable and refillable cups and bottles combat the negative effect of disposables.",
  },
];
---

<section id="values" class="py-32 md:py-44" aria-labelledby="values-heading">
  <Container>
    <div class="grid gap-16 md:grid-cols-12 md:gap-20">
      <!-- Left: eyebrow + heading -->
      <div class="md:col-span-5">
        <p class="mb-6 text-xs font-medium tracking-[0.15em] text-neutral-400 uppercase">
          Values
        </p>
        <h2 id="values-heading" class="text-3xl font-light tracking-tight text-neutral-900 md:text-4xl lg:text-5xl">
          Our Ethos
        </h2>
      </div>

      <!-- Right: statement + grid -->
      <div class="md:col-span-6 md:col-start-7">
        <p class="text-xl font-medium leading-snug tracking-tight text-neutral-900 md:text-2xl">
          We believe great products come from disciplined processes, not cutting corners.
        </p>
        <p class="mt-5 text-base leading-relaxed text-neutral-500 md:text-lg">
          Every decision — from material sourcing to production methods — is guided by three principles that define how we operate.
        </p>

        <!-- Values grid -->
        <div class="mt-12 grid grid-cols-1 gap-px overflow-hidden rounded-xl border border-neutral-100 bg-neutral-100">
          {values.map((item) => (
            <div class="bg-white p-6">
              <h3 class="mb-1.5 text-sm font-medium text-neutral-900">{item.title}</h3>
              <p class="text-sm leading-relaxed text-neutral-500">{item.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </Container>
</section>
