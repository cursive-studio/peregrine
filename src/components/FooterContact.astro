---
const links = [
  { label: "Cups & Bottles", href: "/reusable-bottles" },
  { label: "Textiles", href: "/textiles" },
  { label: "LIVA", href: "/liva" },
];
---

<footer id="contact" class="bg-ink px-5 pt-20 pb-8 text-white md:px-10 md:pt-28 lg:px-14" aria-label="Contact">
  <div class="mx-auto max-w-[1328px]">
    <h2 class="mb-6 max-w-[18ch] text-section font-medium">
      Have a product in mind? Let's make it.
    </h2>
    <a href="mailto:info@peregrinecreativegroup.com" class="text-[clamp(18px,2vw,28px)] text-white underline underline-offset-[6px] transition-opacity hover:opacity-70">
      info@peregrinecreativegroup.com
    </a>

    <div class="mt-24 flex flex-wrap justify-between gap-x-8 gap-y-4 border-t border-[#262626] pt-6 text-sm text-[#a3a3a0]">
      <p>&copy; {new Date().getFullYear()} Peregrine Creative Group</p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2" role="list">
        {links.map((link) => (
          <li><a href={link.href} class="text-[#d4d4d1] transition-colors hover:text-white">{link.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
</footer>
