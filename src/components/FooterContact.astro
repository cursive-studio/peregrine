---
import Container from "./Container.astro";
---

<footer id="contact" class="bg-[#0a0a0a] pt-4 pb-8 text-white md:pt-16 md:pb-8" aria-label="Footer">
  <div class="px-8">
    <div class="grid gap-8 md:grid-cols-2 md:gap-16">
      <!-- Left: brand & info -->
      <div class="flex flex-col justify-between">
        <div>
          <a href="/" class="mb-1 md:mb-4 inline-block text-sm md:text-base font-medium tracking-wide uppercase">
            Peregrine Creative Group
          </a>

          <p class="max-w-md text-xs leading-relaxed font-light text-white/60">
            A design-led partner in sustainable manufacturing, industrial design, and premium
            nutrition. We build products that balance quality, responsibility, and scale.
          </p>
        </div>


      </div>

      <!-- Right: contact form -->
      <div>
        <h2 class="mb-1 text-2xl font-light tracking-tight md:text-3xl">Get in Touch</h2>
        <a href="mailto:info@peregrinecreativegroup.com" class="text-xl md:text-4xl text-white/40 underline">info@peregrinecreativegroup.com</a>
      </div>
    </div>
  </div>

  <div class="mt-8 space-y-2 px-8">
    <p class="text-xs text-white/40">
      &copy; {new Date().getFullYear()} Peregrine Creative Group. All rights reserved.
    </p>

  </div>
</footer>
