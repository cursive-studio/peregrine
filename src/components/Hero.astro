---
interface Props {
  backgroundImage?: string;
}

const {
  backgroundImage = "https://images.unsplash.com/photo-1565043666747-69f6646db940?auto=format&fit=crop&w=1920&q=80",
} = Astro.props;
---

<section class="relative min-h-screen w-full overflow-hidden" aria-label="Hero">
  <video
    src="videos/hero-vid.mp4"
    autoplay
    loop
    muted
    playsinline
    class="absolute inset-0 h-full w-full object-cover blur-sm"
  />
  <div class="absolute inset-0 bg-black/40"></div>

  <div class="relative z-10 flex min-h-screen w-full flex-col justify-center px-[28px] pt-24">
    <h1
      class="hero-enter pb-4 max-w-6xl font-pp-neue-montreal text-[40px] leading-[1.05] font-bold tracking-tight text-white md:text-6xl"
      data-hero-enter
      data-hero-delay="0"
    >
    Peregrine <br/> <span class="text-primary font-normal">CreativeGroup</span>
    </h1>
    <p class="text-white text-sm font-normal tracking-tight max-w-md">
      We design, manufacture and deliver custom physical products for brands across retail, hospitality and events.
    </p>


    <div class="flex flex-wrap items-center gap-3 py-8">
      <a
        href="#projects"
        class="inline-flex items-center gap-2 rounded-full bg-[#0f1f14] px-6 py-3 text-sm text-white transition-opacity duration-200 hover:opacity-90"
      >
        Projects
        <svg class="h-3.5 w-3.5 -rotate-45" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" />
        </svg>
      </a>
      <a
        href="#contact"
        class="inline-flex items-center gap-2 rounded-full bg-white px-6 py-3 text-sm text-neutral-950 transition-opacity duration-200 hover:opacity-90"
      >
        Get in touch
        <svg class="h-3.5 w-3.5 -rotate-45" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" />
        </svg>
      </a>
    </div>

  </div>
</section>

<script>
  import { animate } from "motion";

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const entryEase = [0.22, 1, 0.36, 1] as const;

  document.querySelectorAll<HTMLElement>("[data-hero-enter]").forEach((element) => {
    const delay = Number(element.dataset.heroDelay ?? 0);

    if (prefersReducedMotion) {
      element.style.opacity = "1";
      element.style.transform = "none";
      return;
    }

    animate(
      element,
      { opacity: [0, 1], y: [28, 0] },
      { duration: 0.9, delay, ease: entryEase },
    );
  });
</script>

<style>
  .hero-enter {
    opacity: 0;
    transform: translateY(28px);
  }
</style>
