---
const divisions = [
  { label: "Cups & Bottles", audience: "For client brands", href: "#cups" },
  { label: "Garments & Textiles", audience: "For client brands", href: "#garments" },
  { label: "LIVA", audience: "Our brand", href: "#liva" },
];
---

<section class="relative flex min-h-[max(760px,100svh)] w-full flex-col overflow-hidden bg-[#6f6a62] text-white" aria-label="Hero">
  <img
    src="/images/hero-workshop.webp"
    alt=""
    aria-hidden="true"
    class="absolute -inset-10 h-[calc(100%+80px)] w-[calc(100%+80px)] max-w-none object-cover object-[58%_50%] blur-[18px] saturate-[0.85]"
    width="1440"
    height="740"
    fetchpriority="high"
  />
  <div class="absolute inset-0 bg-[rgb(28_26_22/0.4)]"></div>

  <div class="relative mx-auto flex w-full max-w-[1440px] flex-1 flex-col justify-between gap-12 px-5 pt-32 pb-7 md:px-10 md:pt-40 md:pb-10">
    <h1 class="hero-enter max-w-[1100px] text-display font-normal" data-hero-enter data-hero-delay="0">
      We bring products and brands to life.
    </h1>

    <div class="hero-enter flex flex-col gap-6 md:flex-row md:items-end md:justify-between md:gap-16" data-hero-enter data-hero-delay="0.15">
      <div class="flex max-w-[540px] flex-col gap-8">
        <p class="text-[17px] leading-[1.35] md:text-[21px] md:leading-[1.3]">
          With more than 30 years of combined experience, Peregrine develops products for other brands and creates products of our own — from custom drinkware and garments to LIVA, our Greek extra virgin olive oil brand.
        </p>
        <a href="#approach" aria-label="Scroll to our work" class="hidden size-12 items-center justify-center rounded-full bg-lime text-lime-ink transition-transform duration-200 hover:translate-y-0.5 md:inline-flex">
          <svg class="size-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M8 3v10M4 9l4 4 4-4" /></svg>
        </a>
      </div>

      <ul class="w-full md:w-[340px] md:shrink-0" role="list">
        {divisions.map((division) => (
          <li class="border-t border-white/35 last:border-b">
            <a href={division.href} class="flex min-h-11 items-center justify-between gap-4 py-3 text-[15px] transition-opacity hover:opacity-80">
              <span>{division.label}</span>
              <span class="text-xs text-white/70 md:text-[13px]">{division.audience}</span>
            </a>
          </li>
        ))}
      </ul>

      <div class="flex items-center gap-3 md:hidden">
        <a href="#contact" class="inline-flex min-h-12 flex-1 items-center justify-center rounded-full bg-white text-[15px] font-medium text-ink">Start a project</a>
        <a href="#approach" aria-label="Scroll to our work" class="inline-flex size-12 shrink-0 items-center justify-center rounded-full bg-lime text-lime-ink">
          <svg class="size-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M8 3v10M4 9l4 4 4-4" /></svg>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import { animate } from "motion";

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const entryEase = [0.22, 1, 0.36, 1] as const;

  document.querySelectorAll<HTMLElement>("[data-hero-enter]").forEach((element) => {
    const delay = Number(element.dataset.heroDelay ?? 0);

    if (prefersReducedMotion) {
      element.style.opacity = "1";
      element.style.transform = "none";
      return;
    }

    animate(element, { opacity: [0, 1], y: [28, 0] }, { duration: 0.9, delay, ease: entryEase });
  });
</script>

<style>
  .hero-enter {
    opacity: 0;
    transform: translateY(28px);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-enter {
      opacity: 1;
      transform: none;
    }
  }
</style>
