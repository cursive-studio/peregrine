---
interface Props {
  backgroundImage?: string;
}

const {
  backgroundImage = "https://images.unsplash.com/photo-1565043666747-69f6646db940?auto=format&fit=crop&w=1920&q=80",
} = Astro.props;
---

<section class="relative min-h-screen w-full overflow-hidden" aria-label="Hero">
  <video
    src="videos/hero-vid.mp4"
    autoplay
    loop
    muted
    playsinline
    class="absolute inset-0 h-full w-full object-cover blur-none"
  />
  <div class="absolute inset-0 bg-black/40"></div>

  <div class="relative z-10 flex min-h-screen w-full flex-col justify-end px-[28px] py-[44px]">
    <h1
      class="hero-enter pb-4 max-w-4xl font-pp-neue-montreal text-[40px] md:text-[67px] leading-[1.05] font-normal tracking-tight text-white"
      data-hero-enter
      data-hero-delay="0"
    >
    We help brands bring physical products to market.
    </h1>
    <p class="text-white text-lg font-normal tracking-tight max-w-md">
      We design, manufacture and deliver custom physical products for brands across retail, hospitality and events.
    </p>


    <div class="py-8">
    <button class="px-4 py-2 rounded-full bg-black text-white px-8 py-3 ">
      <a href="#contact">Get in Touch</a>
    </button>
  </div>

  </div>
</section>

<script>
  import { animate } from "motion";

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const entryEase = [0.22, 1, 0.36, 1] as const;

  document.querySelectorAll<HTMLElement>("[data-hero-enter]").forEach((element) => {
    const delay = Number(element.dataset.heroDelay ?? 0);

    if (prefersReducedMotion) {
      element.style.opacity = "1";
      element.style.transform = "none";
      return;
    }

    animate(
      element,
      { opacity: [0, 1], y: [28, 0] },
      { duration: 0.9, delay, ease: entryEase },
    );
  });
</script>

<style>
  .hero-enter {
    opacity: 0;
    transform: translateY(28px);
  }
</style>
