---
import Container from "./Container.astro";

interface Props {
  backgroundImage?: string;
}

const {
  backgroundImage = "https://images.unsplash.com/photo-1565043666747-69f6646db940?auto=format&fit=crop&w=1920&q=80",
} = Astro.props;
---

<section class="relative min-h-[85vh] w-full overflow-hidden md:min-h-screen" aria-label="Hero">
  <!-- Background image -->
  <img
    src="/bg-1.png"
    alt=""
    class="absolute inset-0 h-full w-full object-cover"
    loading="eager"
  />

  <!-- Dark overlay -->
  <div class="absolute inset-0 bg-black/45"></div>

  <!-- Content -->
  <Container class="relative z-10 flex h-full min-h-[85vh] flex-col justify-center pb-16 md:min-h-screen md:pb-0">
    <div class="max-w-screen w-full flex items-center justify-between">
      <h1 class="text-3xl max-w-xl leading-tight font-light text-white md:text-3xl lg:text-4xl">
        Designing, Manufacturing &amp;&nbsp;Delivering
        Sustainable Products at Scale
      </h1>

      <p class="text-white text-lg max-w-lg text-left">
        Peregrine Creative Group is a design-led manufacturing and distribution partner with over 30 years of combined experience across reusable packaging, garments, and sustainable product supply chains.
      </p>
    </div>
    <!-- cta buttons -->
    <div class="flex flex-wrap gap-4 pt-8">
      <a href="/#services" class="group inline-flex items-center overflow-hidden rounded-xl bg-white text-neutral-900 transition-opacity hover:opacity-90">
        <span class="px-6 py-4 text-sm font-medium tracking-wide uppercase">Services</span>
        <span class="flex h-full items-center border-l border-neutral-200 px-4 py-4">
          <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 3l5 5-5 5" /></svg>
        </span>
      </a>
      <a href="/#contact" class="group inline-flex items-center overflow-hidden rounded-xl border border-white/30 text-white transition-opacity hover:opacity-80">
        <span class="px-6 py-4 text-sm font-medium tracking-wide uppercase">Get in touch</span>
        <span class="flex h-full items-center border-l border-white/30 px-4 py-4">
          <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 3l5 5-5 5" /></svg>
        </span>
      </a>
    </div>
    <div class="flex flex-col gap-10 md:flex-col md:items-center md:justify-between">
      <!-- Headline -->
    
      <!-- Stats -->
      <div class="flex absolute bottom-16 right-8 gap-12 text-white md:gap-16">
        <div>
          <span class="block text-4xl font-light md:text-5xl">30+</span>
          <span class="mt-1 block text-xs tracking-wide text-white/70">years experience</span>
        </div>
        <div>
          <span class="block text-4xl font-light md:text-5xl">10+</span>
          <span class="mt-1 block text-xs tracking-wide text-white/70">global partners</span>
        </div>
      </div>
    </div>
  </Container>
</section>
