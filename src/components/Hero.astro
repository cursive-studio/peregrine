---
const divisions = [
  { label: "Cups & Bottles", href: "#cups" },
  { label: "Garments & Textiles", href: "#divisions" },
  { label: "LIVA Olive Oil", href: "#divisions" },
];
---

<section class="relative flex min-h-[max(640px,100svh)] w-full flex-col overflow-hidden bg-[#111412] text-white" aria-label="Hero">
  <video
    class="absolute inset-0 h-full w-full scale-105 object-cover blur-[3px]"
    src="/videos/hero-vid.mp4"
    poster="/videos/hero-poster.jpg"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    aria-hidden="true"
  ></video>
  <div class="absolute inset-0 bg-[rgb(6_10_8/0.55)]"></div>

  <div class="relative mx-auto flex w-full max-w-[1440px] flex-1 flex-col justify-end px-5 pt-32 pb-10 md:px-10 md:pb-12 lg:px-14">
    <h1
      class="hero-enter max-w-[13ch] text-hero font-medium"
      data-hero-enter
      data-hero-delay="0"
    >
      We design, make and deliver products for brands.
    </h1>

    <div
      class="hero-enter mt-10 flex flex-wrap items-end justify-between gap-x-16 gap-y-10 md:mt-16"
      data-hero-enter
      data-hero-delay="0.15"
    >
      <div class="max-w-[30em] flex-[1_1_380px]">
        <p class="text-[clamp(17px,1.4vw,19px)] leading-[1.45] text-[#e8e8e4]">
          Manufacturing and distribution for retail, hospitality and events, built on over 30 years of combined experience.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href="#contact" class="inline-flex items-center gap-2.5 rounded-full bg-white px-6 py-[15px] text-[15px] text-ink transition-opacity hover:opacity-90">
            Start a project
            <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
          </a>
          <a href="#cups" class="inline-flex items-center gap-2.5 rounded-full border border-white/55 px-6 py-[14px] text-[15px] text-white transition-colors hover:bg-white/10">
            Explore our work
          </a>
        </div>
      </div>

      <ul class="flex w-full max-w-[280px] flex-[0_1_280px] flex-col" role="list">
        {divisions.map((division, index) => (
          <li class:list={[index < divisions.length - 1 && "border-b border-white/25"]}>
            <a href={division.href} class="group flex items-center justify-between gap-4 py-2.5 text-[15px] text-white">
              <span>{division.label}</span>
              <svg class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-1" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  import { animate } from "motion";

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const entryEase = [0.22, 1, 0.36, 1] as const;

  document.querySelectorAll<HTMLElement>("[data-hero-enter]").forEach((element) => {
    const delay = Number(element.dataset.heroDelay ?? 0);

    if (prefersReducedMotion) {
      element.style.opacity = "1";
      element.style.transform = "none";
      return;
    }

    animate(element, { opacity: [0, 1], y: [28, 0] }, { duration: 0.9, delay, ease: entryEase });
  });
</script>

<style>
  .hero-enter {
    opacity: 0;
    transform: translateY(28px);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-enter {
      opacity: 1;
      transform: none;
    }
  }
</style>
