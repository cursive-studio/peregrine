---
import PillLink from "./PillLink.astro";
---

<section id="liva" class="relative scroll-mt-20 bg-white md:flex md:min-h-[820px] md:items-center md:justify-end md:overflow-hidden md:bg-[#2a2a28]" aria-labelledby="liva-heading">
  <img
    src="/liva/olive-tree.jpg"
    alt="A hand picking olives from a tree in late sun"
    class="block h-[440px] w-full object-cover md:absolute md:inset-0 md:h-full"
    width="1184"
    height="864"
    loading="lazy"
    decoding="async"
  />

  <div class="relative -mt-[120px] px-5 pb-5 md:mt-0 md:px-10 md:pb-0">
    <div class="flex flex-col gap-[18px] bg-lime p-[22px] text-lime-ink md:min-h-[460px] md:w-[420px] md:gap-5 md:p-6">
      <h2 id="liva-heading" class="text-5xl leading-[0.95] font-normal tracking-[-0.035em] md:mt-auto md:text-[56px]">LIVA</h2>
      <p class="text-base leading-[1.4] md:text-[17px]">
        Our multi-award-winning organic extra virgin olive oil, made from early-harvest Koroneiki olives from the Kalamata region and naturally high in polyphenols.
      </p>
      <PillLink href="/liva" tone="lime-ink" dot="lime-ink">Discover LIVA</PillLink>
    </div>
  </div>
</section>
