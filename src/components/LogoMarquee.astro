---
interface Props {
  /** "follows-band" sits directly under a grey band; "standalone" sits under a hero. */
  spacing?: "follows-band" | "standalone";
}

const { spacing = "follows-band" } = Astro.props;

const clients = [
  { src: "/peregrine-client-logos/cola.svg", alt: "Coca-Cola", width: 300, height: 168 },
  { src: "/peregrine-client-logos/tango.svg", alt: "Tango Ice Blast", width: 305, height: 165, invert: true },
  { src: "/peregrine-client-logos/vimto.svg", alt: "Vimto", width: 275, height: 136 },
  { src: "/peregrine-client-logos/frozon-brothers-logo%201.svg", alt: "Frozen Brothers", width: 500, height: 375 },
  { src: "/peregrine-client-logos/hoburne.svg", alt: "Hoburne Holiday Parks", width: 560, height: 333 },
  { src: "/peregrine-client-logos/pleasure-beach.svg", alt: "Pleasure Beach Blackpool", width: 500, height: 498, tall: true },
  { src: "/peregrine-client-logos/steri.svg", alt: "SteriPack", width: 259, height: 194 },
];
---

<section class="bg-band" aria-labelledby="clients-heading">
  <div
    class:list={[
      spacing === "standalone" ? "py-10 md:py-16" : "pb-16 md:pb-32",
    ]}
  >
    <h2 id="clients-heading" class="sr-only">Trusted by brands, venues &amp; events</h2>

    <div class="marquee relative w-full overflow-hidden">
      <div class="marquee-track flex w-max">
        {[0, 1].map((copy) => (
          <ul class="flex shrink-0 items-center gap-14 pr-14 md:gap-[88px] md:pr-[88px]" role="list" aria-hidden={copy === 1 ? "true" : undefined}>
            {clients.map((client) => (
              <li class="shrink-0">
                <img
                  src={client.src}
                  alt={copy === 1 ? "" : client.alt}
                  width={client.width}
                  height={client.height}
                  class:list={[
                    "marquee-logo block w-auto",
                    client.tall ? "h-[34px] md:h-[42px]" : "h-7 md:h-9",
                    client.invert && "is-inverted",
                  ]}
                  loading="lazy"
                  decoding="async"
                />
              </li>
            ))}
          </ul>
        ))}
      </div>
      <div class="edge edge-left" aria-hidden="true"></div>
      <div class="edge edge-right" aria-hidden="true"></div>
    </div>
  </div>
</section>

<style>
  .marquee {
    --fade: 80px;
    mask-image: linear-gradient(to right, transparent, #000 var(--fade), #000 calc(100% - var(--fade)), transparent);
  }

  .marquee-track {
    animation: marquee 30s linear infinite;
  }

  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  .marquee-logo {
    filter: grayscale(1);
    opacity: 0.7;
    mix-blend-mode: multiply;
  }

  /* Tango's artwork sits on black; invert it so it reads dark-on-light like the rest */
  .marquee-logo.is-inverted {
    filter: grayscale(1) invert(1);
  }

  /* Soft blur where logos enter and leave */
  .edge {
    position: absolute;
    inset-block: 0;
    width: var(--fade);
    pointer-events: none;
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
  }
  .edge-left {
    left: 0;
    mask-image: linear-gradient(to right, #000, transparent);
  }
  .edge-right {
    right: 0;
    mask-image: linear-gradient(to left, #000, transparent);
  }

  @media (min-width: 768px) {
    .marquee {
      --fade: 240px;
    }
    .marquee-track {
      animation-duration: 40s;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
