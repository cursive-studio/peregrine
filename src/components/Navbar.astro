---
interface Props {
  variant?: "overlay" | "solid";
}

const { variant = "solid" } = Astro.props;

const isOverlay = variant === "overlay";

const serviceLinks = [
  { label: "Product development", href: "/reusable-bottles" },
  { label: "Production", href: "/textiles" },
  { label: "Distribution", href: "/olive-oil-supplements" },
];

const navItems = [
  { label: "Services", href: "/#services", children: serviceLinks },
  { label: "Projects", href: "/#projects" },
  { label: "About", href: "/#about" },
];
---

<header
  id="site-header"
  class:list={[
    "fixed top-0 left-0 z-50 w-full transition-colors duration-300",
    isOverlay ? "bg-transparent" : "bg-white/95 backdrop-blur-md",
  ]}
  data-overlay={isOverlay ? "true" : "false"}
>
  <nav
    id="site-nav"
    class:list={[
      "flex items-center justify-between px-[28px] py-5 transition-colors duration-300",
      isOverlay ? "text-white" : "text-neutral-950",
    ]}
    aria-label="Main navigation"
  >
    <a href="/" class="text-[14px] font-medium tracking-tight">
      Peregrine Creative
    </a>

    <ul class="hidden items-center gap-8 md:flex" role="list">
      {navItems.map((item) => (
        item.children ? (
          <li class="group relative">
            <a
              href={item.href}
              class="inline-flex items-center gap-1.5 text-[14px] transition-opacity duration-200 hover:opacity-60"
              aria-haspopup="true"
            >
              {item.label}
              <svg class="h-3 w-3 transition-transform duration-200 group-hover:rotate-180" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M2.5 4.5L6 8l3.5-3.5" />
              </svg>
            </a>

            <div class="invisible absolute top-full left-1/2 z-50 pt-3 opacity-0 transition-all duration-200 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 -translate-x-1/2">
              <ul
                class="min-w-[13rem] rounded-xl border border-neutral-200 bg-white py-2 text-neutral-950 shadow-lg"
                role="menu"
                aria-label="Services"
              >
                {item.children.map((child) => (
                  <li role="none">
                    <a
                      href={child.href}
                      class="block px-4 py-2.5 text-[14px] transition-colors duration-150 hover:bg-neutral-50"
                      role="menuitem"
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ) : (
          <li>
            <a href={item.href} class="text-[14px] transition-opacity duration-200 hover:opacity-60">
              {item.label}
            </a>
          </li>
        )
      ))}
    </ul>

    <button
      class="text-[14px] transition-opacity duration-200 hover:opacity-60 md:hidden"
      aria-label="Toggle menu"
      id="mobile-menu-toggle"
      aria-expanded="false"
    >
      Menu
    </button>
  </nav>
</header>

<div
  id="mobile-menu"
  class="fixed inset-0 z-[60] hidden flex-col bg-neutral-950 text-white"
>
  <div class="flex items-center justify-between px-[28px] py-5">
    <a href="/" class="text-[14px] font-medium tracking-tight">Peregrine Creative</a>
    <button
      class="text-[14px] transition-opacity duration-200 hover:opacity-60"
      id="mobile-menu-close"
      aria-label="Close menu"
    >
      Close
    </button>
  </div>

  <div class="flex flex-1 flex-col justify-center px-[28px]">
    <nav class="flex flex-col gap-8" aria-label="Mobile navigation">
      {navItems.map((item) => (
        item.children ? (
          <div>
            <a href={item.href} class="text-4xl font-light tracking-tight transition-opacity duration-200 hover:opacity-60">
              {item.label}
            </a>
            <ul class="mt-5 space-y-3 border-l border-white/20 pl-5">
              {item.children.map((child) => (
                <li>
                  <a href={child.href} class="text-lg text-white/70 transition-opacity duration-200 hover:opacity-100">
                    {child.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ) : (
          <a href={item.href} class="text-4xl font-light tracking-tight transition-opacity duration-200 hover:opacity-60">
            {item.label}
          </a>
        )
      ))}
    </nav>
  </div>

  <div class="px-[28px] pb-10">
    <p class="text-sm text-white/40">&copy; {new Date().getFullYear()} Peregrine Creative Group</p>
  </div>
</div>

<script>
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const close = document.getElementById("mobile-menu-close");
  const header = document.getElementById("site-header");
  const nav = document.getElementById("site-nav");

  function openMenu() {
    menu?.classList.remove("hidden");
    menu?.classList.add("flex");
    toggle?.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
  }

  function closeMenu() {
    menu?.classList.add("hidden");
    menu?.classList.remove("flex");
    toggle?.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
  }

  toggle?.addEventListener("click", openMenu);
  close?.addEventListener("click", closeMenu);

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", closeMenu);
  });

  const isOverlay = header?.dataset.overlay === "true";

  function updateNavbar() {
    if (!header || !nav || !isOverlay) return;

    const scrolled = window.scrollY > 50;

    if (scrolled) {
      header.classList.remove("bg-transparent");
      header.classList.add("bg-white/95", "backdrop-blur-md");
      nav.classList.remove("text-white");
      nav.classList.add("text-neutral-950");
    } else {
      header.classList.add("bg-transparent");
      header.classList.remove("bg-white/95", "backdrop-blur-md");
      nav.classList.add("text-white");
      nav.classList.remove("text-neutral-950");
    }
  }

  updateNavbar();
  window.addEventListener("scroll", updateNavbar, { passive: true });
</script>
