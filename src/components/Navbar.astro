---
interface Props {
  variant?: "overlay" | "solid";
}

const { variant = "solid" } = Astro.props;
const isOverlay = variant === "overlay";
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

const navItems = [
  { label: "Cups & Bottles", href: "/reusable-bottles" },
  { label: "Textiles", href: "/textiles" },
  { label: "Olive Oil", href: "/olive-oil-supplements" },
  { label: "Sustainability", href: "/#green" },
];
---

<header
  id="site-header"
  class:list={["site-header fixed top-0 left-0 z-50 w-full transition-colors duration-300", !isOverlay && "is-solid"]}
  data-overlay={isOverlay ? "true" : "false"}
>
  <nav
    class="mx-auto flex max-w-[1440px] items-center justify-between gap-8 px-5 py-4 md:px-10 lg:px-14"
    aria-label="Main navigation"
  >
    <a href="/" class="shrink-0" aria-label="Peregrine Creative Group — home">
      <img src="/peregrine-logo.png" alt="" class="nav-logo h-11 w-11" width="44" height="44" />
    </a>

    <ul class="hidden items-center gap-7 md:flex" role="list">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class="nav-link text-[15px] transition-opacity duration-200 hover:opacity-60"
            aria-current={currentPath === item.href ? "page" : undefined}
          >
            {item.label}
          </a>
        </li>
      ))}
      <li>
        <a href="mailto:info@peregrinecreativegroup.com" class="nav-cta inline-flex rounded-full px-5 py-3 text-[15px] transition-opacity duration-200 hover:opacity-85">
          Get in touch
        </a>
      </li>
    </ul>

    <button
      class="nav-link text-[15px] transition-opacity duration-200 hover:opacity-60 md:hidden"
      aria-label="Open menu"
      id="mobile-menu-toggle"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      Menu
    </button>
  </nav>
</header>

<div id="mobile-menu" class="fixed inset-0 z-[60] hidden flex-col bg-ink text-white">
  <div class="flex items-center justify-between px-5 py-4">
    <a href="/" aria-label="Peregrine Creative Group — home">
      <img src="/peregrine-logo.png" alt="" class="h-11 w-11 invert" width="44" height="44" />
    </a>
    <button class="text-[15px] transition-opacity duration-200 hover:opacity-60" id="mobile-menu-close" aria-label="Close menu">
      Close
    </button>
  </div>

  <nav class="flex flex-1 flex-col justify-center gap-6 px-5" aria-label="Mobile navigation">
    {navItems.map((item) => (
      <a href={item.href} class="text-4xl font-medium tracking-tight transition-opacity duration-200 hover:opacity-60">
        {item.label}
      </a>
    ))}
    <a href="mailto:info@peregrinecreativegroup.com" class="mt-4 self-start rounded-full bg-white px-6 py-3.5 text-[15px] text-ink">Get in touch</a>
  </nav>

  <div class="px-5 pb-10">
    <p class="text-sm text-white/60">&copy; {new Date().getFullYear()} Peregrine Creative Group</p>
  </div>
</div>

<style>
  /* Overlay state: transparent bar over a dark hero */
  .site-header {
    color: #fff;
    background: transparent;
  }
  .site-header .nav-logo {
    filter: invert(1);
  }
  .site-header .nav-cta {
    background: #fff;
    color: var(--color-ink);
  }

  /* Solid state: after scrolling, or on pages without a dark hero */
  .site-header.is-solid {
    color: var(--color-ink);
    background: rgb(255 255 255 / 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .site-header.is-solid .nav-logo {
    filter: none;
  }
  .site-header.is-solid .nav-cta {
    background: var(--color-forest);
    color: #fff;
  }

  .nav-link[aria-current="page"] {
    text-decoration: underline;
    text-underline-offset: 6px;
  }
</style>

<script>
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const close = document.getElementById("mobile-menu-close");
  const header = document.getElementById("site-header");

  function openMenu() {
    menu?.classList.remove("hidden");
    menu?.classList.add("flex");
    toggle?.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
  }

  function closeMenu() {
    menu?.classList.add("hidden");
    menu?.classList.remove("flex");
    toggle?.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
  }

  toggle?.addEventListener("click", openMenu);
  close?.addEventListener("click", closeMenu);
  menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menu && !menu.classList.contains("hidden")) closeMenu();
  });

  if (header?.dataset.overlay === "true") {
    const update = () => header.classList.toggle("is-solid", window.scrollY > 50);
    update();
    window.addEventListener("scroll", update, { passive: true });
  }
</script>
