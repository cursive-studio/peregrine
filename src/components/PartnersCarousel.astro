---
import Container from "./Container.astro";

const partners = [
  "Frozen Brothers",
  "Tango Ice Blast",
  "Coca-Cola",
  "Odeon",
  "Slush Puppie",
  "Vimto",
  "Steri Pack",
];
---

<section id="partners" class="py-24 md:py-32">
  <Container>
    <p class="mb-16 text-xs font-medium tracking-[0.15em] text-neutral-400 uppercase md:mb-20">
      Trusted by
    </p>
  </Container>

  <div class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-24 bg-gradient-to-r from-white to-transparent md:w-40"></div>
    <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-24 bg-gradient-to-l from-white to-transparent md:w-40"></div>

    <div class="partners-track flex w-max items-center">
      {[...partners, ...partners].map((name) => (
        <div class="flex shrink-0 items-center px-8 md:px-14">
          <span class="whitespace-nowrap text-lg font-medium tracking-tight text-neutral-300 md:text-xl">
            {name}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .partners-track {
    animation: scroll-partners 35s linear infinite;
  }

  .partners-track:hover {
    animation-play-state: paused;
  }

  @keyframes scroll-partners {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
