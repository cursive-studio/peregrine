---
import Container from "./Container.astro";

const partners = [
  "Frozen Brothers",
  "Tango Ice Blast",
  "Coca-Cola",
  "Odeon",
  "Slush Puppie",
  "Vimto",
  "Steri Pack",
];
---

<section id="partners" class="border-t border-neutral-200 py-24 md:py-32">
  <Container>
    <!-- Header -->
    <div class="mb-16 flex items-start justify-between md:mb-20">
      <h2 class="text-3xl font-light text-neutral-800 md:text-4xl">
        We Are<br />Trusted By
      </h2>
      <span class="rounded border border-neutral-300 px-3 py-1 text-[10px] font-medium tracking-[0.15em] text-neutral-500 uppercase">
        Our Partners
      </span>
    </div>
  </Container>

  <!-- Divider -->
  <div class="border-t border-neutral-200"></div>

  <!-- Infinite carousel -->
  <div class="relative overflow-hidden py-12 md:py-16">
    <!-- Fade edges -->
    <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-24 bg-gradient-to-r from-white to-transparent"></div>
    <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-24 bg-gradient-to-l from-white to-transparent"></div>

    <div class="partners-track flex w-max items-center">
      {[...partners, ...partners].map((name) => (
        <div class="flex h-16 shrink-0 items-center justify-center border-r border-neutral-100 px-12 md:px-16">
          <span class="whitespace-nowrap text-lg font-semibold tracking-tight text-neutral-800 md:text-xl">
            {name}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .partners-track {
    animation: scroll-partners 25s linear infinite;
  }

  .partners-track:hover {
    animation-play-state: paused;
  }

  @keyframes scroll-partners {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
