---
const values = [
  {
    title: "Quality",
    copy: "Our responsibility to the environment goes beyond legal and regulatory requirements.",
  },
  {
    title: "Innovation",
    copy: "Cleaner materials, smarter production methods and formats that cut waste without compromising performance.",
  },
  {
    title: "Sustainability",
    copy: "Responsible sourcing, reusable systems and efficient logistics that protect product quality and the planet.",
  },
];
---

<section id="green" class="bg-forest px-5 py-20 text-white md:px-10 md:py-28 lg:px-14 lg:py-36" aria-labelledby="green-heading">
  <div class="mx-auto max-w-[1328px]">
    <div class="mb-16 flex flex-wrap justify-between gap-x-16 gap-y-8 md:mb-18">
      <h2 id="green-heading" class="flex-[1_1_360px] text-section font-medium">
        Pere<span class="text-leaf">Green</span>
      </h2>
      <p class="max-w-[32em] flex-[1_1_480px] text-lg leading-[1.55] text-[#d4ddd6]">
        Our cups and bottles are made from fully recyclable PET. Reusable and refillable formats replace disposables, and we minimise waste at every step of production. Biodegradable cups and straws are the next step.
      </p>
    </div>

    <div class="grid gap-10 border-t border-[#2e4234] pt-10 md:grid-cols-3">
      {values.map((value) => (
        <div>
          <h3 class="mb-3 text-xl font-medium">{value.title}</h3>
          <p class="text-base leading-[1.55] text-[#c2cec5]">{value.copy}</p>
        </div>
      ))}
    </div>
  </div>
</section>
