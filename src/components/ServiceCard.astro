---
interface Props {
  title: string;
  image: string;
  href?: string;
  overlayOpacity?: string;
}

const {
  title,
  image,
  href = "#",
  overlayOpacity = "bg-black/35",
} = Astro.props;
---

<a
  href={href}
  class="group relative block aspect-[3/4] overflow-hidden rounded-2xl"
>
  <img
    src={image}
    alt={title}
    class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
    loading="lazy"
  />
  <div class:list={["absolute inset-0 transition-opacity duration-500 group-hover:opacity-60", overlayOpacity]}></div>
  <div class="absolute inset-0 z-10 flex flex-col justify-end p-6 md:p-8">
    <h3 class="text-xl font-medium text-white md:text-2xl">{title}</h3>
    <span class="mt-2 text-[10px] font-medium tracking-[0.2em] text-white/60 uppercase">
      Learn More
    </span>
  </div>
</a>
