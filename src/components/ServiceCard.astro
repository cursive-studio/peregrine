---
interface Props {
  title: string;
  tag: string;
  image: string;
  href?: string;
}

const { title, tag, image, href = "#" } = Astro.props;
---

<a href={href} class="group block">
  <div class="relative aspect-square overflow-hidden rounded-2xl">
    <img
      src={image}
      alt={title}
      class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-black/10 transition-opacity duration-500 group-hover:bg-black/20"></div>
    <!-- Tag pill -->
    <div class="absolute bottom-4 left-4 z-10">
      <span class="inline-block rounded bg-white/90 px-3 py-1 text-[10px] font-medium tracking-[0.12em] text-neutral-700 uppercase backdrop-blur-sm">
        {tag}
      </span>
    </div>
  </div>
  <h3 class="mt-5 text-xl font-medium text-neutral-900 md:text-2xl">
    {title}
  </h3>
</a>
