---
interface Props {
  title: string;
  image: string;
  href?: string;
}

const { title, image, href } = Astro.props;

const Tag = href ? "a" : "div";
---

<Tag
  href={href}
  class:list={[
    "group relative block overflow-hidden rounded-2xl",
    href && "transition-opacity duration-200 hover:opacity-95",
  ]}
>
  <img
    src={image}
    alt={title}
    class="aspect-square md:aspect-[3/4] w-full object-cover transition-transform duration-700 group-hover:scale-[1.02]"
    loading="lazy"
  />

  <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/35 via-black/5 to-transparent"></div>

  <h3 class="absolute bottom-6 left-6 text-lg font-normal tracking-tight text-white md:bottom-8 md:left-8 md:text-xl">
    {title}
  </h3>
</Tag>
