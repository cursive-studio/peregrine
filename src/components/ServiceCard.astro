---
interface Props {
  title: string;
  image: string;
  items: string[];
  href?: string;
}

const { title, image, items, href } = Astro.props;

const Tag = href ? "a" : "article";
---

<Tag
  href={href}
  class:list={[
    "group relative block aspect-[484/386] w-full max-w-[584px] overflow-hidden rounded-2xl",
    href && "focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-950",
  ]}
>
  <img
    src={image}
    alt=""
    width="484"
    height="346"
    class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
    loading="lazy"
    aria-hidden="true"
  />

  <div class="absolute inset-0 bg-black/45 transition-colors duration-300 group-hover:bg-black/50"></div>

  <div class="relative flex h-full flex-col justify-between p-6 md:p-8">
    <ul class="space-y-0.5 text-sm leading-snug text-white md:text-base">
      {items.map((item) => (
        <li>{item}</li>
      ))}
    </ul>

    <div class="flex items-end justify-between gap-4">
      <h3 class="text-3xl font-medium tracking-tight text-white md:text-3xl">
        {title}
      </h3>

      <svg
        class="mb-1 h-5 w-5 shrink-0 text-white opacity-0 transition-all duration-300 group-hover:translate-x-0.5 group-hover:opacity-100 group-focus-visible:opacity-100"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      >
        <path d="M3 8h10M9 4l4 4-4 4" />
      </svg>
    </div>
  </div>
</Tag>
