---
import ServiceCard from "./ServiceCard.astro";

interface ServiceItem {
  title: string;
  image: string;
  href?: string;
}

interface Props {
  services?: ServiceItem[];
}

const {
  services = [
    {
      title: "Design",
      image: "/images/services/design-card.png",
    },
    {
      title: "Manufacturing",
      image: "/images/services/manufacture-card.png",
    },
    {
      title: "Distribution",
      image: "/images/services/distribution-card.png",
    },
  ],
} = Astro.props;
---

<section id="services" class="w-full bg-[#fbfbfa] py-28 md:py-36" aria-labelledby="services-heading">
  <div class="px-6 md:px-12 lg:px-16">
    <h2 id="services-heading" class="mb-10 text-2xl font-normal tracking-tight text-neutral-950 md:mb-12">
      Services
    </h2>

    <div class="grid gap-4 sm:grid-cols-2 md:gap-6 lg:grid-cols-3">
      {services.map((service) => (
        <ServiceCard
          title={service.title}
          image={service.image}
          href={service.href}
        />
      ))}
    </div>
  </div>
</section>
