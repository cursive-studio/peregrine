---
import Container from "./Container.astro";
import ServiceCard from "./ServiceCard.astro";

interface ServiceItem {
  title: string;
  tag: string;
  image: string;
  href?: string;
}

interface Props {
  services?: ServiceItem[];
}

const {
  services = [
    {
      title: "Reusable Bottles",
      tag: "Manufacturing",
      image:
        "https://images.unsplash.com/photo-1602143407151-7111542de6e8?auto=format&fit=crop&w=800&q=80",
      href: "/reusable-bottles",
    },
    {
      title: "Textiles",
      tag: "Industrial Design",
      image:
        "https://images.unsplash.com/photo-1558171813-4c088753af8f?auto=format&fit=crop&w=800&q=80",
      href: "/textiles",
    },
    {
      title: "Olive Oil & Supplements",
      tag: "Distribution",
      image:
        "https://images.unsplash.com/photo-1474979266404-7eaacbcd87c5?auto=format&fit=crop&w=800&q=80",
      href: "/olive-oil-supplements",
    },
  ],
} = Astro.props;
---

<section id="services" class="py-24 md:py-32" aria-labelledby="services-heading">
  <Container>
    <!-- Header row -->
    <div class="mb-12 flex flex-col gap-4 md:mb-16 md:flex-row md:items-end md:justify-between">
      <p class="text-[11px] font-medium tracking-[0.2em] text-neutral-400 uppercase">
        <span id="services-heading">Services</span>
      </p>
      <p class="max-w-md text-right text-sm leading-relaxed text-neutral-500 md:text-base">
        We help brands bring ideas to market — responsibly, efficiently, and at scale.
      </p>
    </div>

    <!-- Cards grid -->
    <div class="grid gap-8 md:grid-cols-3">
      {services.map((service) => (
        <ServiceCard
          title={service.title}
          tag={service.tag}
          image={service.image}
          href={service.href}
        />
      ))}
    </div>
  </Container>
</section>
