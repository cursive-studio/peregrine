---
import PillLink from "./PillLink.astro";
---

<section id="approach" class="scroll-mt-20 bg-white" aria-labelledby="approach-heading">
  <div class="mx-auto flex max-w-[1440px] flex-col gap-6 px-5 py-20 md:flex-row md:items-end md:justify-between md:gap-16 md:px-10 md:py-32">
    <h2 id="approach-heading" class="text-heading font-normal">
      Different products.<br />
      <span class="text-quiet">One hands-on approach.</span>
    </h2>
    <div class="flex flex-col gap-6 md:w-[380px] md:shrink-0 md:gap-7">
      <p class="text-lg leading-[1.35] text-muted md:text-[21px] md:leading-[1.3]">
        Whether we’re making products for clients or developing our own, we care about the details and stand behind the finished result.
      </p>
      <PillLink href="#contact" dot="ink">Start a project</PillLink>
    </div>
  </div>
</section>
