---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Peregrine Creative Group — Reusable Cups, Custom Drinkware & Product Manufacturing",
  description = "Peregrine Creative Group designs, makes and delivers products for brands — from reusable cups and custom drinkware to garments and olive oil distribution.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="bg-white font-sans text-ink antialiased">
    <slot />
  </body>
</html>
