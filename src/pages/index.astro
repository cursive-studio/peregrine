import Hero from "../components/Hero.astro";
import AboutSplit from "../components/AboutSplit.astro";
import TrustedBy from "../components/TrustedBy.astro";
import ServicesGrid from "../components/ServicesGrid.astro";
import IndustriesSection from "../components/IndustriesSection.astro";
