---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import Statement from "../components/Statement.astro";
import LivaFeature from "../components/LivaFeature.astro";
import ClientBrands from "../components/ClientBrands.astro";
import LogoMarquee from "../components/LogoMarquee.astro";
import Peregreen from "../components/Peregreen.astro";
import FooterContact from "../components/FooterContact.astro";
---

<BaseLayout>
  <Navbar variant="overlay" />
  <main>
    <Hero />
    <Statement />
    <LivaFeature />
    <ClientBrands />
    <LogoMarquee />
    <Peregreen />
  </main>
  <FooterContact />
</BaseLayout>
