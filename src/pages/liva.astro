---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import FooterContact from "../components/FooterContact.astro";
import BatchCertificateLookup from "../components/BatchCertificateLookup.astro";

const amazonUrl = "https://www.amazon.co.uk/dp/B0GQWBKKBR";
const wholesaleUrl = "mailto:info@peregrinecreativegroup.com?subject=LIVA%20wholesale%20enquiry";
const specSheetUrl = "mailto:info@peregrinecreativegroup.com?subject=LIVA%20spec%20sheet";

const spec = [
  { label: "Cultivar", value: "Koroneiki, early harvest" },
  { label: "Origin", value: "Kalamata, Greece (PDO)" },
  { label: "Extraction", value: "Mechanical, cold pressed at low temperature" },
  { label: "Polyphenols", value: "1,300+ mg/kg, lab tested every batch" },
  { label: "Acidity", value: "<0.3%" },
  { label: "Certification", value: "Organic, BIOHELLAS GR-BIO-03; organoleptic analysis" },
  { label: "Health claim", value: "Qualifies under EU Regulation 432/2012" },
  { label: "Format", value: "500ml glass bottle" },
];

const customers = [
  {
    title: "Retail & delis",
    copy: "A premium, award-winning shelf product with PDO and organic credentials your customers recognise.",
  },
  {
    title: "Hospitality",
    copy: "A robust, peppery finishing oil for restaurants and hotels that want provenance on the table.",
  },
  {
    title: "Research & clinics",
    copy: "Consistent, documented polyphenol levels, with independent lab results for every batch.",
  },
];

const supplyChain = [
  { title: "Direct sourcing", copy: "A direct relationship with the grower in Kalamata." },
  { title: "Lab tested", copy: "Independent testing on every batch shipped." },
  { title: "Traceable", copy: "Certified and documented from tree to bottle." },
  { title: "UK fulfilment", copy: "Wholesale direct, and retail via Amazon UK." },
];
---

<BaseLayout
  title="LIVA Organic Extra Virgin Olive Oil | Peregrine Creative Group"
  description="LIVA Groves organic extra virgin olive oil: ultra-high polyphenols, early harvest Koroneiki from Kalamata PDO. Sourced and distributed in the UK by Peregrine."
  image="/og/olive-oil.jpg"
  imageAlt="LIVA organic extra virgin olive oil, distributed by Peregrine Creative Group"
>
  <Navbar variant="overlay" />

  <main>
    <!-- Hero -->
    <section class="relative flex min-h-[max(640px,90svh)] w-full flex-col overflow-hidden bg-[#1b1d16] text-white" aria-label="Hero">
      <img src="/liva/liva-hero.webp" alt="" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover" width="1536" height="1024" loading="eager" />
      <div class="absolute inset-0 bg-[rgb(10_12_6/0.55)]"></div>

      <div class="relative mx-auto flex w-full max-w-[1440px] flex-1 flex-col justify-end px-5 pt-32 pb-14 md:px-10 md:pb-20 lg:px-14 lg:pb-24">
        <div class="flex flex-wrap items-end justify-between gap-x-16 gap-y-10">
          <h1 class="hero-enter max-w-[12ch] flex-[1_1_640px] text-hero font-medium" data-hero-enter data-hero-delay="0">
            LIVA organic extra virgin olive oil.
          </h1>
          <div class="hero-enter max-w-[380px] flex-[0_1_380px]" data-hero-enter data-hero-delay="0.15">
            <p class="text-lg leading-normal text-[#e8e8e4]">
              Early-harvest olive oil from Kalamata, Greece, with a robust flavour and peppery finish. Available on Amazon UK, with wholesale supply through Peregrine.
            </p>
            <div class="mt-7 flex flex-wrap gap-3">
              <a href={amazonUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-2.5 rounded-full bg-white px-6 py-[15px] text-[15px] text-ink transition-opacity hover:opacity-90">
                Buy on Amazon
              </a>
              <a href={wholesaleUrl} class="inline-flex items-center gap-2.5 rounded-full border border-white/55 px-6 py-[14px] text-[15px] text-white transition-colors hover:bg-white/10">
                Wholesale enquiries
              </a>
              <a href="#batch-certificate" class="inline-flex items-center rounded-full border border-white/55 px-6 py-[14px] text-[15px] text-white transition-colors hover:bg-white/10">Find your batch certificate</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Spec sheet -->
    <section id="spec" class="scroll-mt-24 px-5 py-20 md:px-10 md:py-28 lg:px-14 lg:py-36" aria-labelledby="spec-heading">
      <div class="mx-auto flex max-w-[1328px] flex-wrap items-start gap-x-20 gap-y-12">
        <div class="min-w-0 flex-[1_1_440px] bg-stone">
          <img src="/liva/oil-bottle.webp" alt="LIVA organic extra virgin olive oil, 500ml bottle" class="block aspect-square w-full object-cover" width="1024" height="1024" loading="lazy" decoding="async" />
        </div>
        <div class="min-w-0 flex-[1_1_520px]">
          <h2 id="spec-heading" class="mb-3 text-section font-medium">LIVA Groves Organic Extra Virgin Olive Oil</h2>
          <p class="mb-10 text-lg leading-normal text-muted">Gold Award, Olympia Awards 2025, for sensory quality and production excellence.</p>
          <dl class="grid grid-cols-[minmax(120px,1fr)_2fr] border-t border-stone-line">
            {spec.map((row) => (
              <>
                <dt class="border-b border-stone-line py-4 pr-4 text-[15px] text-subtle">{row.label}</dt>
                <dd class="border-b border-stone-line py-4 text-base">{row.value}</dd>
              </>
            ))}
          </dl>
          <a href={specSheetUrl} class="mt-8 inline-flex items-center gap-2.5 rounded-full bg-forest px-6 py-[15px] text-[15px] text-white transition-opacity hover:opacity-90">
            Request the full spec sheet
          </a>
        </div>
      </div>
    </section>

    <section id="batch-certificate" class="scroll-mt-24 bg-stone px-5 py-20 md:px-10 md:py-28 lg:px-14 lg:py-36" aria-labelledby="certificate-heading">
      <div class="mx-auto max-w-[1328px]">
        <BatchCertificateLookup>
          <div slot="intro">
            <h2 id="certificate-heading" class="mb-5 max-w-[18ch] text-section font-medium">Find your batch certificate.</h2>
            <p class="max-w-lg text-lg leading-normal text-muted">Every bottle has a batch number. Enter yours to find the certificate associated with your olive oil.</p>
          </div>
          <p slot="help" class="mt-8 text-sm text-muted">Need help finding your batch? <a href="mailto:info@peregrinecreativegroup.com" class="underline underline-offset-4">Contact Peregrine</a></p>
        </BatchCertificateLookup>
      </div>
    </section>

    <!-- Who we supply -->
    <section class="bg-stone px-5 py-20 md:px-10 md:py-28 lg:px-14 lg:py-36" aria-labelledby="supply-heading">
      <div class="mx-auto max-w-[1328px]">
        <h2 id="supply-heading" class="mb-14 text-section font-medium">Who we supply</h2>
        <ul class="grid gap-6 md:grid-cols-3" role="list">
          {customers.map((customer) => (
            <li class="flex flex-col gap-3.5 bg-white p-9">
              <h3 class="text-2xl font-medium">{customer.title}</h3>
              <p class="text-base leading-[1.55] text-muted">{customer.copy}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Supply chain -->
    <section class="px-5 py-20 md:px-10 md:py-28 lg:px-14 lg:py-36" aria-labelledby="chain-heading">
      <div class="mx-auto max-w-[1328px]">
        <div class="mb-14 flex flex-wrap gap-x-16 gap-y-8">
          <h2 id="chain-heading" class="max-w-[16ch] flex-[1_1_420px] text-section font-medium">One supply chain, from Kalamata to the UK</h2>
          <p class="max-w-[32em] flex-[1_1_420px] self-end text-lg leading-[1.55] text-muted">
            Peregrine manages sourcing, quality assurance and UK distribution, so stock stays consistent and every bottle is accounted for.
          </p>
        </div>
        <ol class="grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-4" role="list">
          {supplyChain.map((step) => (
            <li class="border-t border-ink pt-5">
              <h3 class="mb-2.5 text-xl font-medium">{step.title}</h3>
              <p class="text-base leading-normal text-subtle">{step.copy}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Closing: buy a bottle -->
    <section class="px-5 pb-20 md:px-10 md:pb-28 lg:px-14 lg:pb-36" aria-labelledby="consumer-heading">
      <div class="mx-auto flex max-w-[1328px] flex-wrap bg-stone">
        <img
          src="/liva/liva-pour.webp"
          alt="LIVA olive oil poured over a Greek salad with feta and tomatoes"
          class="block aspect-square max-h-[680px] w-full min-w-0 flex-[1_1_520px] object-cover"
          width="1025"
          height="1040"
          loading="lazy"
          decoding="async"
        />
        <div class="flex min-w-0 flex-[1_1_420px] flex-col justify-center gap-5 p-10 md:p-14 lg:p-[72px]">
          <h2 id="consumer-heading" class="max-w-[14ch] text-section font-medium">Buying for your own kitchen?</h2>
          <p class="max-w-[28em] text-lg leading-[1.55] text-muted">
            Robust, with a peppery finish. Made for drizzling over salads, finishing dishes and dipping bread. The 500ml bottle is available on Amazon UK.
          </p>
          <a href={amazonUrl} target="_blank" rel="noopener" class="mt-3 inline-flex items-center gap-2.5 self-start rounded-full bg-forest px-6 py-[15px] text-[15px] text-white transition-opacity hover:opacity-90">
            Buy on Amazon
          </a>
        </div>
      </div>
    </section>
  </main>

  <FooterContact />
</BaseLayout>

<script>
  import { animate } from "motion";

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const entryEase = [0.22, 1, 0.36, 1] as const;

  document.querySelectorAll<HTMLElement>("[data-hero-enter]").forEach((element) => {
    const delay = Number(element.dataset.heroDelay ?? 0);

    if (prefersReducedMotion) {
      element.style.opacity = "1";
      element.style.transform = "none";
      return;
    }

    animate(element, { opacity: [0, 1], y: [28, 0] }, { duration: 0.9, delay, ease: entryEase });
  });
</script>

<style>
  .hero-enter {
    opacity: 0;
    transform: translateY(28px);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-enter {
      opacity: 1;
      transform: none;
    }
  }
</style>
