---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import ClientLogos from "../components/ClientLogos.astro";
import Peregreen from "../components/Peregreen.astro";
import FooterContact from "../components/FooterContact.astro";

const products = [
  {
    title: "Reusable Cups",
    image: "/bottles/tango-ice-blast.webp",
    alt: "Tango Ice Blast reusable dome-lid cup with twin straws",
    width: 2332,
    height: 3886,
    copy: "Refillable branded cups with dome lids and straws — including thermochromic IML cups that change colour with a cold drink.",
  },
  {
    title: "Custom Vessels",
    image: "/bottles/fanta-twister.webp",
    alt: "Frozen Fanta Twister custom vessel",
    width: 1022,
    height: 1806,
    copy: "Shaped, brand-specific vessels designed from scratch for a product launch or promotion.",
  },
  {
    title: "Slush Yards",
    image: "/bottles/slush-puppy-bone.webp",
    alt: "Slush Puppie bone-shaped slush yard",
    width: 1295,
    height: 1943,
    copy: "Tall novelty yards for slush and frozen drinks — the souvenir format for parks and events.",
  },
  {
    title: "Custom Bottles",
    image: "/bottles/juice-bottle.webp",
    alt: "Fruit-topped custom drinks bottle with straw",
    width: 1536,
    height: 2561,
    copy: "Character and fruit-topped bottles that turn a kids' drink into something worth keeping.",
  },
];

const process = [
  { title: "Industrial design", copy: "Concept development and form exploration." },
  { title: "3D proto-renders", copy: "Photorealistic visualisations before production." },
  { title: "Physical samples", copy: "Tangible prototypes for testing and approval." },
  { title: "Production & delivery", copy: "Manufacture at scale, delivered to your venues." },
];
---

<BaseLayout
  title="Reusable Cups & Custom Drinkware — Peregrine Creative Group"
  description="We design and manufacture reusable cups, custom slush yards, bottles and promotional drinkware for cinemas, theme parks, stadiums and events."
>
  <Navbar variant="overlay" />

  <main>
    <!-- Hero -->
    <section class="relative flex min-h-[max(640px,90svh)] w-full flex-col overflow-hidden bg-[#1a1d1b] text-white" aria-label="Hero">
      <img src="/bottles/factory.webp" alt="" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover" width="1000" height="667" loading="eager" />
      <div class="absolute inset-0 bg-[rgb(8_12_10/0.58)]"></div>

      <div class="relative mx-auto flex w-full max-w-[1440px] flex-1 flex-col justify-end px-5 pt-32 pb-14 md:px-10 md:pb-20 lg:px-14 lg:pb-24">
        <h1 class="hero-enter max-w-[16ch] text-hero font-medium" data-hero-enter data-hero-delay="0">
          Reusable cups and custom vessels for cinemas, theme parks, stadiums and events.
        </h1>
        <div class="hero-enter mt-10 flex flex-wrap gap-3" data-hero-enter data-hero-delay="0.15">
          <a href="#products" class="inline-flex items-center gap-2.5 rounded-full bg-white px-6 py-[15px] text-[15px] text-ink transition-opacity hover:opacity-90">
            View products
            <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M8 3v10M4 9l4 4 4-4" /></svg>
          </a>
          <a href="#contact" class="inline-flex items-center gap-2.5 rounded-full border border-white/55 px-6 py-[14px] text-[15px] text-white transition-colors hover:bg-white/10">
            Start a project
          </a>
        </div>
      </div>
    </section>

    <!-- Client logos -->
    <section class="border-b border-stone-line px-5 py-11 md:px-10 lg:px-14" aria-label="Trusted by">
      <ClientLogos />
    </section>

    <!-- Intro -->
    <section class="px-5 py-20 md:px-10 md:py-28 lg:px-14 lg:py-36" aria-labelledby="intro-heading">
      <div class="mx-auto flex max-w-[1328px] flex-wrap gap-x-16 gap-y-8">
        <h2 id="intro-heading" class="flex-[1_1_360px] text-section font-medium">
          Redefine by redesign
        </h2>
        <div class="max-w-[34em] flex-[1_1_480px]">
          <p class="mb-5 text-[clamp(22px,2vw,28px)] leading-[1.25] tracking-[-0.01em]">
            Most food and drink packaging is boring, but it doesn't have to be.
          </p>
          <p class="text-lg leading-[1.55] text-muted">
            Imagine a reusable cinema cup that holds two drinks, a slush yard shaped like a star, or a straw that changes colour as you use it. With the right design, packaging becomes a souvenir most people will want to take home.
          </p>
        </div>
      </div>
    </section>

    <!-- Products -->
    <section id="products" class="scroll-mt-24 px-5 pb-20 md:px-10 md:pb-28 lg:px-14 lg:pb-36" aria-labelledby="products-heading">
      <div class="mx-auto max-w-[1328px]">
        <h2 id="products-heading" class="mb-10 text-section font-medium">Products</h2>
        <ul class="grid gap-x-4 gap-y-12 sm:grid-cols-2 lg:grid-cols-4" role="list">
          {products.map((product) => (
            <li class="flex flex-col gap-5">
              <div class="relative aspect-square overflow-hidden bg-stone">
                <img
                  src={product.image}
                  alt={product.alt}
                  class="absolute inset-0 h-full w-full object-contain p-8 mix-blend-multiply md:p-10"
                  width={product.width}
                  height={product.height}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div>
                <h3 class="mb-2 text-[22px] font-medium tracking-[-0.01em]">{product.title}</h3>
                <p class="text-base leading-normal text-subtle">{product.copy}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- The range -->
    <section class="px-5 md:px-10 lg:px-14" aria-label="The range">
      <div class="mx-auto flex max-w-[1328px] justify-center bg-white">
        <img
          src="/images/cups.webp"
          alt="A range of Peregrine reusable cups, bottles and slush yards"
          class="block h-auto w-full max-w-[1100px]"
          width="2199"
          height="1896"
          loading="lazy"
          decoding="async"
        />
      </div>
    </section>

    <!-- Process -->
    <section class="px-5 py-20 md:px-10 md:py-28 lg:px-14 lg:py-36" aria-labelledby="process-heading">
      <div class="mx-auto max-w-[1328px]">
        <div class="mb-16 flex flex-wrap gap-x-16 gap-y-8">
          <h2 id="process-heading" class="max-w-[16ch] flex-[1_1_360px] text-section font-medium">
            From concept to finished product
          </h2>
          <p class="max-w-[32em] flex-[1_1_480px] self-end text-lg leading-[1.55] text-muted">
            One partner from the first sketch to the delivered product — plus the marketing ideas to launch it.
          </p>
        </div>
        <ol class="grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-4" role="list">
          {process.map((step) => (
            <li class="border-t border-ink pt-5">
              <h3 class="mb-2.5 text-xl font-medium">{step.title}</h3>
              <p class="text-base leading-normal text-subtle">{step.copy}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <Peregreen />
  </main>

  <FooterContact />
</BaseLayout>

<script>
  import { animate } from "motion";

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const entryEase = [0.22, 1, 0.36, 1] as const;

  document.querySelectorAll<HTMLElement>("[data-hero-enter]").forEach((element) => {
    const delay = Number(element.dataset.heroDelay ?? 0);

    if (prefersReducedMotion) {
      element.style.opacity = "1";
      element.style.transform = "none";
      return;
    }

    animate(element, { opacity: [0, 1], y: [28, 0] }, { duration: 0.9, delay, ease: entryEase });
  });
</script>

<style>
  .hero-enter {
    opacity: 0;
    transform: translateY(28px);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-enter {
      opacity: 1;
      transform: none;
    }
  }
</style>
