---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import PageHero from "../components/PageHero.astro";
import LogoMarquee from "../components/LogoMarquee.astro";
import Peregreen from "../components/Peregreen.astro";
import FooterContact from "../components/FooterContact.astro";

const products = [
  {
    title: "Reusable Cups",
    image: "/bottles/tango-ice-blast.webp",
    alt: "Tango Ice Blast reusable dome-lid cup with twin straws",
    width: 2332,
    height: 3886,
    copy: "Refillable branded cups with dome lids and straws — including thermochromic IML cups that change colour with a cold drink.",
  },
  {
    title: "Custom Vessels",
    image: "/bottles/fanta-twister.webp",
    alt: "Frozen Fanta Twister custom vessel",
    width: 1022,
    height: 1806,
    copy: "Shaped, brand-specific vessels designed from scratch for a product launch or promotion.",
  },
  {
    title: "Slush Yards",
    image: "/bottles/slush-puppy-bone.webp",
    alt: "Slush Puppie bone-shaped slush yard",
    width: 1295,
    height: 1943,
    copy: "Tall novelty yards for slush and frozen drinks — the souvenir format for parks and events.",
  },
  {
    title: "Custom Bottles",
    image: "/bottles/juice-bottle.webp",
    alt: "Fruit-topped custom drinks bottle with straw",
    width: 1536,
    height: 2561,
    copy: "Character and fruit-topped bottles that turn a kids' drink into something worth keeping.",
  },
];

const process = [
  { title: "Industrial design", copy: "Concept development and form exploration." },
  { title: "3D proto-renders", copy: "Photorealistic visualisations before production." },
  { title: "Physical samples", copy: "Tangible prototypes for testing and approval." },
  { title: "Production & delivery", copy: "Manufacture at scale, delivered to your venues." },
];
---

<BaseLayout
  title="Reusable Cups & Custom Drinkware | Peregrine Creative Group"
  description="We design and manufacture reusable cups, custom slush yards, bottles and promotional drinkware for cinemas, theme parks, stadiums and events."
  image="/og/cups.jpg"
  imageAlt="Reusable cups and custom drinkware by Peregrine Creative Group"
>
  <Navbar variant="overlay" />

  <main>
    <PageHero
      title="Reusable cups and custom vessels for cinemas, theme parks, stadiums and events."
      image="/bottles/factory.webp"
      imageWidth={1000}
      imageHeight={667}
      primary={{ label: "View products", href: "#products", icon: "down" }}
      secondary={{ label: "Start a project", href: "#contact" }}
    />

    <LogoMarquee spacing="standalone" />

    <!-- Intro -->
    <section class="bg-white" aria-labelledby="intro-heading">
      <div class="mx-auto flex max-w-[1440px] flex-col gap-5 px-5 pt-[72px] pb-14 md:flex-row md:justify-between md:gap-16 md:px-10 md:pt-32 md:pb-24">
        <h2 id="intro-heading" class="text-heading font-normal md:max-w-[560px]">Redefine by redesign</h2>
        <div class="flex flex-col gap-5 md:max-w-[600px]">
          <p class="text-[22px] leading-[1.28] tracking-[-0.015em] md:text-[28px] md:leading-[1.25]">
            Most food and drink packaging is boring, but it doesn’t have to be.
          </p>
          <p class="text-[17px] leading-[1.5] text-muted md:text-lg">
            Imagine a reusable cinema cup that holds two drinks, a slush yard shaped like a star, or a straw that changes colour as you use it. With the right design, packaging becomes a souvenir most people will want to take home.
          </p>
        </div>
      </div>
    </section>

    <!-- Products -->
    <section id="products" class="scroll-mt-24 bg-white" aria-label="Products">
      <ul class="mx-auto grid max-w-[1440px] grid-cols-2 gap-x-4 gap-y-8 px-5 pb-[72px] md:px-10 md:pb-32 lg:grid-cols-4" role="list">
        {products.map((product) => (
          <li class="flex flex-col gap-3 md:gap-5">
            <div class="relative aspect-square overflow-hidden bg-band">
              <img
                src={product.image}
                alt={product.alt}
                class="absolute inset-0 h-full w-full object-contain p-[18px] mix-blend-multiply md:p-8"
                width={product.width}
                height={product.height}
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="flex flex-col gap-2 md:gap-2.5">
              <h3 class="text-lg font-normal tracking-[-0.02em] md:text-2xl">{product.title}</h3>
              <p class="text-sm leading-[1.45] text-subtle md:text-base md:leading-[1.5]">{product.copy}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- The range -->
    <section class="bg-white" aria-label="The range">
      <div class="flex justify-center px-5 py-8 md:py-16">
        <img
          src="/images/cups.webp"
          alt="A range of Peregrine reusable cups, bottles and slush yards"
          class="block h-auto w-full max-w-[350px] md:max-w-[820px]"
          width="2199"
          height="1896"
          loading="lazy"
          decoding="async"
        />
      </div>
    </section>

    <!-- Process -->
    <section class="bg-white" aria-labelledby="process-heading">
      <div class="mx-auto max-w-[1440px] px-5 py-[72px] md:px-10 md:py-32">
        <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between md:gap-16">
          <h2 id="process-heading" class="text-heading font-normal md:max-w-[560px]">From concept to finished product</h2>
          <p class="text-[17px] leading-[1.45] text-muted md:max-w-[420px] md:text-[21px] md:leading-[1.35]">
            One partner from the first sketch to the delivered product — plus the marketing ideas to launch it.
          </p>
        </div>
        <ul class="mt-8 grid md:mt-16 md:grid-cols-4 md:gap-6" role="list">
          {process.map((step) => (
            <li class="flex flex-col gap-1.5 border-t border-ink-soft py-5 md:gap-3 md:pt-6 md:pb-0">
              <h3 class="text-xl font-normal tracking-[-0.02em] md:text-2xl">{step.title}</h3>
              <p class="text-[15px] leading-[1.45] text-subtle md:text-base md:leading-[1.5]">{step.copy}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <Peregreen />
  </main>

  <FooterContact />
</BaseLayout>
