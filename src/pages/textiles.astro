---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Container from "../components/Container.astro";
import FooterContact from "../components/FooterContact.astro";
---

<BaseLayout title="Textiles — Peregrine Creative Group" description="Responsibly manufactured textiles from design to delivery.">
  <Navbar variant="solid" />

  <main class="pt-16">
    <!-- Page Hero -->
    <section class="relative overflow-hidden py-24 md:py-32">
      <Container>
        <p class="mb-6 text-[11px] font-medium tracking-[0.2em] text-neutral-400 uppercase">
          Services
        </p>
        <h1 class="max-w-3xl text-4xl font-light text-neutral-900 md:text-5xl lg:text-6xl">
          Textiles
        </h1>
        <p class="mt-6 max-w-xl text-base leading-relaxed text-neutral-500 md:text-lg">
          From concept to finished product, we design and manufacture responsible textiles — apparel, accessories, and homeware built for quality and longevity.
        </p>
      </Container>
    </section>

    <!-- Hero image -->
    <section class="px-6 md:px-10">
      <div class="mx-auto max-w-7xl overflow-hidden rounded-2xl">
        <img
          src="https://images.unsplash.com/photo-1558171813-4c088753af8f?auto=format&fit=crop&w=1600&q=80"
          alt="Textile manufacturing"
          class="aspect-[21/9] w-full object-cover"
          loading="eager"
        />
      </div>
    </section>

    <!-- Details -->
    <section class="py-24 md:py-32">
      <Container>
        <div class="grid gap-16 md:grid-cols-12">
          <div class="md:col-span-5">
            <h2 class="text-2xl font-light text-neutral-800 md:text-3xl">
              Responsible by Design
            </h2>
          </div>
          <div class="md:col-span-6 md:col-start-7">
            <p class="text-base leading-relaxed text-neutral-600 md:text-lg">
              The textile industry accounts for roughly 10% of global carbon emissions. We work with certified mills and suppliers to source organic cotton, recycled polyester, and low-impact dyes — giving your brand a product line that performs without costing the planet.
            </p>
          </div>
        </div>
      </Container>
    </section>

    <!-- Capabilities -->
    <section class="border-t border-neutral-200 py-24 md:py-32">
      <Container>
        <p class="mb-16 text-[11px] font-medium tracking-[0.2em] text-neutral-400 uppercase">
          Capabilities
        </p>
        <div class="grid gap-12 md:grid-cols-3">
          <div>
            <h3 class="mb-3 text-lg font-medium text-neutral-900">Fabric Development</h3>
            <p class="text-sm leading-relaxed text-neutral-500">
              Custom weave structures, weight selection, and fabric finishing — developed in partnership with specialist mills to match your exact specification.
            </p>
          </div>
          <div>
            <h3 class="mb-3 text-lg font-medium text-neutral-900">Pattern &amp; Sampling</h3>
            <p class="text-sm leading-relaxed text-neutral-500">
              Our in-house team produces detailed tech packs, digital patterns, and physical samples so every piece is production-ready before it reaches the factory floor.
            </p>
          </div>
          <div>
            <h3 class="mb-3 text-lg font-medium text-neutral-900">Ethical Production</h3>
            <p class="text-sm leading-relaxed text-neutral-500">
              We partner exclusively with audited factories that meet international labour and environmental standards, including GOTS and OEKO-TEX certification.
            </p>
          </div>
        </div>
      </Container>
    </section>

    <!-- CTA -->
    <section class="border-t border-neutral-200 py-24 md:py-32">
      <Container>
        <div class="flex flex-col items-center text-center">
          <h2 class="mb-4 text-2xl font-light text-neutral-800 md:text-3xl">Ready to get started?</h2>
          <p class="mb-8 max-w-md text-sm leading-relaxed text-neutral-500">
            Whether you're launching a new apparel line or sourcing custom homeware, we'll help you bring it to market responsibly.
          </p>
          <a
            href="/#contact"
            class="rounded-lg bg-[#22384A] px-8 py-3 text-xs font-semibold tracking-[0.15em] text-white uppercase transition-opacity hover:opacity-90"
          >
            Get in Touch
          </a>
        </div>
      </Container>
    </section>
  </main>

  <FooterContact />
</BaseLayout>
