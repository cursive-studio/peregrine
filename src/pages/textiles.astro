---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Container from "../components/Container.astro";
import FooterContact from "../components/FooterContact.astro";
---

<BaseLayout
  title="Textiles — Peregrine Creative Group"
  description="Rapid garment solutions from design to delivery. European speed, global scale, sustainable production."
>
  <Navbar variant="overlay" />

  <main>
    <!-- Full-bleed Hero -->
    <section class="relative min-h-screen w-full overflow-hidden" aria-label="Hero">
      <img
        src="/textiles/textiles-hero.webp"
        alt="Textile manufacturing"
        class="absolute inset-0 h-full w-full object-cover"
        loading="eager"
      />
      <div class="absolute inset-0 bg-black/40"></div>

      <div class="relative z-10 mx-auto flex min-h-screen w-full max-w-7xl flex-col justify-end px-6 pb-24 md:px-12 md:pb-32 lg:px-16">
        <h1 class="max-w-4xl text-4xl leading-[1.08] font-light tracking-tight text-white md:text-5xl lg:text-7xl">
          Rapid garment solutions for a fast-changing market
        </h1>

        <div class="mt-16 flex flex-wrap gap-4">
          <a href="/#contact" class="group inline-flex items-center overflow-hidden rounded-xl bg-white text-neutral-900 transition-opacity hover:opacity-90">
            <span class="px-7 py-4 text-sm font-medium tracking-wide uppercase">Get in touch</span>
            <span class="flex items-center border-l border-neutral-200 px-5 py-4">
              <svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 3l5 5-5 5" /></svg>
            </span>
          </a>
          <a href="#capabilities" class="group inline-flex items-center overflow-hidden rounded-xl border border-white/20 text-white transition-opacity hover:opacity-80">
            <span class="px-7 py-4 text-sm font-medium tracking-wide uppercase">View capabilities</span>
            <span class="flex items-center border-l border-white/20 px-5 py-4">
              <svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 3l5 5-5 5" /></svg>
            </span>
          </a>
        </div>
      </div>
    </section>

    <!-- Credentials bar -->
    <section class="border-b border-neutral-100 bg-neutral-50 py-10">
      <Container>
        <p class="mb-5 text-center text-xs font-medium tracking-[0.15em] text-neutral-400 uppercase">Producing for</p>
        <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-3">
          <span class="text-sm font-medium text-neutral-700">Stone Island</span>
          <span class="text-sm font-medium text-neutral-700">Hugo Boss</span>
          <span class="text-sm font-medium text-neutral-700">Jil Sander</span>
          <span class="text-sm font-medium text-neutral-700">Diesel</span>
          <span class="text-sm font-medium text-neutral-700">Massimo Dutti</span>
          <span class="text-sm font-medium text-neutral-700">OYSHO</span>
        </div>
      </Container>
    </section>

    <!-- Overview -->
    <section class="py-32 md:py-44">
      <Container>
        <div class="grid gap-16 md:grid-cols-12 md:gap-20">
          <div class="md:col-span-5">
            <p class="mb-6 text-xs font-medium tracking-[0.15em] text-neutral-400 uppercase">
              RAGScreative
            </p>
            <h2 class="text-3xl font-light tracking-tight text-neutral-900 md:text-4xl">
              Design, manufacturing, and distribution under one roof
            </h2>
          </div>
          <div class="md:col-span-6 md:col-start-7">
            <p class="text-base leading-relaxed text-neutral-600 md:text-lg">
              Our integrated network seamlessly connects design, manufacturing, and distribution to deliver sustainable garment solutions with a significantly reduced carbon footprint. With decades of experience producing for major fashion labels, we operate as both a creative and operational partner — not just a supplier.
            </p>
            <p class="mt-6 text-base leading-relaxed text-neutral-600 md:text-lg">
              In-house logistics via our freight division (M&W Freight) ensures total supply-chain control from first sample to final delivery.
            </p>
          </div>
        </div>
      </Container>
    </section>

    <!-- Full-width image break -->
    <section class="px-6 md:px-12 lg:px-16">
      <div class="mx-auto max-w-7xl overflow-hidden rounded-2xl">
        <img
          src="/textiles/textiles-spools.webp"
          alt="Textile production facility"
          class="aspect-[21/9] w-full object-cover"
          loading="lazy"
        />
      </div>
    </section>

    <!-- Production network — dark section -->
    <section class="bg-neutral-950 py-32 text-white md:py-44">
      <Container>
        <div class="grid gap-16 md:grid-cols-12 md:gap-20">
          <div class="md:col-span-5">
            <p class="mb-6 text-xs font-medium tracking-[0.15em] uppercase text-white/40">
              Global network
            </p>
            <h2 class="text-3xl font-light tracking-tight md:text-4xl lg:text-5xl">
              European speed. Global scale.
            </h2>
          </div>
          <div class="md:col-span-6 md:col-start-7">
            <p class="text-xl font-medium leading-snug tracking-tight md:text-2xl">
              Nearshore European production combined with Far East manufacturing — balancing speed, cost, and quality.
            </p>
            <div class="mt-12 grid grid-cols-1 gap-px overflow-hidden rounded-xl border border-white/10 bg-white/10 sm:grid-cols-2">
              <div class="bg-neutral-950 p-6">
                <h3 class="mb-1.5 text-sm font-medium text-white">European Production</h3>
                <p class="text-sm leading-relaxed text-white/50">UK, Greece, Bulgaria, Turkey, Egypt — rapid turnaround, ethical standards</p>
              </div>
              <div class="bg-neutral-950 p-6">
                <h3 class="mb-1.5 text-sm font-medium text-white">Far East Manufacturing</h3>
                <p class="text-sm leading-relaxed text-white/50">China, Pakistan, Bangladesh — scalable output, competitive pricing</p>
              </div>
              <div class="bg-neutral-950 p-6">
                <h3 class="mb-1.5 text-sm font-medium text-white">In-House Logistics</h3>
                <p class="text-sm leading-relaxed text-white/50">M&W Freight — cargo departs on time, arrives on schedule</p>
              </div>
              <div class="bg-neutral-950 p-6">
                <h3 class="mb-1.5 text-sm font-medium text-white">Ethical Focus</h3>
                <p class="text-sm leading-relaxed text-white/50">Fair labour, certified factories, quality without compromise</p>
              </div>
            </div>
          </div>
        </div>
      </Container>
    </section>

    <!-- Capabilities grid -->
    <section id="capabilities" class="py-32 md:py-44">
      <Container>
        <div class="mb-16 max-w-2xl">
          <p class="mb-6 text-xs font-medium tracking-[0.15em] text-neutral-400 uppercase">Capabilities</p>
          <h2 class="text-3xl font-light tracking-tight text-neutral-900 md:text-4xl">
            From concept to delivery
          </h2>
        </div>
        <div class="grid grid-cols-1 gap-px overflow-hidden rounded-xl border border-neutral-100 bg-neutral-100 sm:grid-cols-2 lg:grid-cols-4">
          <div class="bg-white p-8">
            <h3 class="mb-2 text-base font-medium text-neutral-900">Design</h3>
            <p class="text-sm leading-relaxed text-neutral-500">
              Experienced designers work closely with clients to create designs that capture brand essence — functional and visually distinctive.
            </p>
          </div>
          <div class="bg-white p-8">
            <h3 class="mb-2 text-base font-medium text-neutral-900">Manufacturing</h3>
            <p class="text-sm leading-relaxed text-neutral-500">
              Production through factories used by Stone Island, Hugo Boss, and Diesel — ensuring quality and consistency at scale.
            </p>
          </div>
          <div class="bg-white p-8">
            <h3 class="mb-2 text-base font-medium text-neutral-900">Innovation</h3>
            <p class="text-sm leading-relaxed text-neutral-500">
              Proprietary fabrics like SEIDON (water-repellent 100% cotton) and QR traceability systems built in-house.
            </p>
          </div>
          <div class="bg-white p-8">
            <h3 class="mb-2 text-base font-medium text-neutral-900">Logistics</h3>
            <p class="text-sm leading-relaxed text-neutral-500">
              Total supply-chain management with in-house freight — controlling every step from production to delivery.
            </p>
          </div>
        </div>
      </Container>
    </section>

    <!-- Innovation highlight with image -->
    <section class="bg-neutral-50 py-32 md:py-44">
      <Container>
        <div class="grid items-center gap-16 md:grid-cols-12 md:gap-20">
          <div class="md:col-span-6">
            <div class="overflow-hidden rounded-2xl">
              <img
                src="/textiles/textiles.jpg"
                alt="Sustainable textile materials"
                class="aspect-[4/3] w-full object-cover"
                loading="lazy"
              />
            </div>
          </div>
          <div class="md:col-span-5 md:col-start-8">
            <p class="mb-6 text-xs font-medium tracking-[0.15em] text-neutral-400 uppercase">
              Green Initiative
            </p>
            <h2 class="mb-6 text-2xl font-medium tracking-tight text-neutral-900 md:text-3xl">
              Sustainability built in, not bolted on
            </h2>
            <p class="text-base leading-relaxed text-neutral-500 md:text-lg">
              We produce garments from recycled PET plastics — bottles are shredded into chips, melted, and extruded into yarn. The result is durable, water-resistant, and keeps disposable plastics out of landfill.
            </p>
            <p class="mt-4 text-base leading-relaxed text-neutral-500 md:text-lg">
              Our QR traceability system lets customers scan a hang-tag and instantly see where their garment was made, how it was produced, and the energy saved in the process.
            </p>
          </div>
        </div>
      </Container>
    </section>

    <!-- CTA -->
    <section class="py-32 md:py-44">
      <Container>
        <div class="flex flex-col items-center text-center">
          <h2 class="mb-6 text-3xl font-light tracking-tight text-neutral-900 md:text-4xl">
            Ready to get started?
          </h2>
          <p class="mb-10 max-w-md text-base leading-relaxed text-neutral-500">
            Whether you're launching a new apparel line or scaling existing production, we'll help you bring it to market — rapidly and responsibly.
          </p>
          <a href="/#contact" class="group inline-flex items-center overflow-hidden rounded-xl bg-neutral-900 text-white transition-opacity hover:opacity-90">
            <span class="px-7 py-4 text-sm font-medium tracking-wide uppercase">Get in Touch</span>
            <span class="flex items-center border-l border-white/15 px-5 py-4">
              <svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 3l5 5-5 5" /></svg>
            </span>
          </a>
        </div>
      </Container>
    </section>
  </main>

  <FooterContact />
</BaseLayout>
