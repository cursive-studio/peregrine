---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Container from "../components/Container.astro";
import FooterContact from "../components/FooterContact.astro";
---

<BaseLayout
  title="Textiles — Peregrine Creative Group"
  description="Responsibly manufactured textiles from design to delivery."
>
  <Navbar variant="solid" />

  <main class="pt-16">
    <!-- Page Hero -->
    <section class="relative overflow-hidden py-24 md:py-32">
      <Container>
        <p
          class="mb-6 text-[11px] font-medium tracking-[0.2em] text-neutral-400 uppercase"
        >
          Services
        </p>
        <h1
          class="max-w-3xl text-4xl font-light text-neutral-900 md:text-5xl lg:text-6xl"
        >
          Rapid garment production, built for a fast-moving market.
        </h1>
        <p
          class="mt-6 max-w-xl text-base leading-relaxed text-neutral-500 md:text-lg"
        >
          We design, manufacture, and deliver high-quality apparel through an
          integrated global network — combining European production with Far
          East scalability and a reduced carbon footprint.
        </p>

        <!-- cta buttons -->
        <div class="flex flex-wrap gap-4 pt-8">
          <a href="/#contact" class="group inline-flex items-center overflow-hidden rounded-xl bg-neutral-900 text-white transition-opacity hover:opacity-90">
            <span class="px-6 py-4 text-sm font-medium tracking-wide uppercase">Get in touch</span>
            <span class="flex h-full items-center border-l border-white/20 px-4 py-4">
              <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 3l5 5-5 5" /></svg>
            </span>
          </a>
          <a href="/#services" class="group inline-flex items-center overflow-hidden rounded-xl border border-neutral-300 text-neutral-900 transition-opacity hover:opacity-70">
            <span class="px-6 py-4 text-sm font-medium tracking-wide uppercase">View our capabilities</span>
            <span class="flex h-full items-center border-l border-neutral-300 px-4 py-4">
              <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 3l5 5-5 5" /></svg>
            </span>
          </a>
        </div>
      </Container>
    </section>

    <!-- Hero image -->
    <section class="px-6 md:px-10">
      <div class="mx-auto max-w-7xl overflow-hidden rounded-2xl">
        <img
          src="https://images.unsplash.com/photo-1558171813-4c088753af8f?auto=format&fit=crop&w=1600&q=80"
          alt="Textile manufacturing"
          class="aspect-[21/9] w-full object-cover"
          loading="eager"
        />
      </div>
    </section>

    <!-- Details -->
    <section class="py-24 md:py-32">
      <Container>
        <div class="grid gap-16 md:grid-cols-12">
          <div class="md:col-span-5">
            <h2 class="text-2xl font-light text-neutral-800 md:text-3xl">
              End-to-end garment solutions
            </h2>
          </div>
          <div class="md:col-span-6 md:col-start-7">
            <p class="text-base leading-relaxed text-neutral-600 md:text-lg">
              We provide a fully integrated service across design,
              manufacturing, and distribution — giving brands a single partner
              to manage the entire supply chain. With over 30 years of combined
              experience, they specialise in delivering high-quality garments
              quickly, efficiently, and responsibly.
            </p>
          </div>
        </div>
      </Container>
    </section>

    <!-- From concept to delivery -->
    <section class="border-t border-neutral-200 py-24 md:py-32">
      <Container>
        <div class="grid gap-16 md:grid-cols-12 md:gap-8">
          <!-- Left: title & copy -->
          <div class="md:col-span-5">
            <h2 class="mb-6 text-3xl font-light tracking-tight text-neutral-800 md:text-4xl">
              From concept to delivery
            </h2>
            <p class="text-base leading-relaxed text-neutral-500 md:text-lg">
              RAGS operates as a vertically integrated system, covering every stage of garment production — from initial design through to final delivery.
            </p>
          </div>

          <!-- Right: capability list -->
          <div class="md:col-span-6 md:col-start-7">
            <p class="mb-8 text-[11px] font-medium tracking-[0.2em] text-neutral-400 uppercase">
              Capabilities
            </p>
            <ul class="divide-y divide-neutral-200">
              <li class="py-4 first:pt-0">
                <h3 class="text-base font-medium text-neutral-900 md:text-lg">Design &amp; creative direction</h3>
              </li>
              <li class="py-4">
                <h3 class="text-base font-medium text-neutral-900 md:text-lg">Garment manufacturing</h3>
              </li>
              <li class="py-4">
                <h3 class="text-base font-medium text-neutral-900 md:text-lg">Textile innovation</h3>
              </li>
              <li class="py-4 last:pb-0">
                <h3 class="text-base font-medium text-neutral-900 md:text-lg">Logistics &amp; distribution</h3>
              </li>
            </ul>
            <p class="mt-8 text-sm leading-relaxed text-neutral-500">
              They position themselves as both a creative and operational partner, not just a supplier.
            </p>
          </div>
        </div>
      </Container>
    </section>

    <!-- Global production -->
    <section class="border-t border-neutral-200 py-24 md:py-32">
      <Container>
        <div class="grid gap-16 md:grid-cols-12 md:gap-8">
          <!-- Left: title & copy -->
          <div class="md:col-span-5">
            <h2 class="mb-6 text-3xl font-light tracking-tight text-neutral-800 md:text-4xl">
              European speed.<br />Global scale.
            </h2>
            <p class="text-base leading-relaxed text-neutral-500 md:text-lg">
              RAGS combines nearshore European production with Far East manufacturing to balance speed, cost, and quality.
            </p>
          </div>

          <!-- Right: key points -->
          <div class="md:col-span-6 md:col-start-7">
            <p class="mb-8 text-[11px] font-medium tracking-[0.2em] text-neutral-400 uppercase">
              Key Points
            </p>
            <ul class="divide-y divide-neutral-200">
              <li class="py-4 first:pt-0">
                <h3 class="text-base font-medium text-neutral-900 md:text-lg">European production</h3>
                <p class="mt-1 text-sm text-neutral-500">UK, Greece, Bulgaria, Turkey, Egypt</p>
              </li>
              <li class="py-4">
                <h3 class="text-base font-medium text-neutral-900 md:text-lg">Global reach</h3>
                <p class="mt-1 text-sm text-neutral-500">China, Pakistan, Bangladesh</p>
              </li>
              <li class="py-4">
                <h3 class="text-base font-medium text-neutral-900 md:text-lg">Ethical production focus</h3>
              </li>
              <li class="py-4 last:pb-0">
                <h3 class="text-base font-medium text-neutral-900 md:text-lg">Competitive pricing without sacrificing quality</h3>
              </li>
            </ul>
            <p class="mt-8 text-sm leading-relaxed text-neutral-500">
              This hybrid model allows them to deliver rapid turnaround with scalable output.
            </p>
          </div>
        </div>
      </Container>
    </section>

    <!-- Specialist capabilities -->
    <section class="border-t border-neutral-200 py-24 md:py-32">
      <Container>
        <p class="mb-16 text-[11px] font-medium tracking-[0.2em] text-neutral-400 uppercase md:mb-20">
          Specialist Capabilities
        </p>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          <div class="rounded-2xl border border-neutral-200 bg-neutral-50 p-8">
            <span class="mb-6 flex h-10 w-10 items-center justify-center rounded-full bg-neutral-900 text-sm font-medium text-white">01</span>
            <h3 class="mb-3 text-lg font-medium text-neutral-900">Design</h3>
            <p class="text-sm leading-relaxed text-neutral-500">
              Collaborative design process focused on brand identity, functionality, and market relevance.
            </p>
          </div>
          <div class="rounded-2xl border border-neutral-200 bg-neutral-50 p-8">
            <span class="mb-6 flex h-10 w-10 items-center justify-center rounded-full bg-neutral-900 text-sm font-medium text-white">02</span>
            <h3 class="mb-3 text-lg font-medium text-neutral-900">Manufacturing</h3>
            <p class="text-sm leading-relaxed text-neutral-500">
              Production through trusted factories used by major fashion brands, ensuring quality and consistency.
            </p>
          </div>
          <div class="rounded-2xl border border-neutral-200 bg-neutral-50 p-8">
            <span class="mb-6 flex h-10 w-10 items-center justify-center rounded-full bg-neutral-900 text-sm font-medium text-white">03</span>
            <h3 class="mb-3 text-lg font-medium text-neutral-900">Innovation</h3>
            <p class="text-sm leading-relaxed text-neutral-500">
              Development of proprietary fabrics and technologies (e.g. water-repellent cotton, traceability systems).
            </p>
          </div>
          <div class="rounded-2xl border border-neutral-200 bg-neutral-50 p-8">
            <span class="mb-6 flex h-10 w-10 items-center justify-center rounded-full bg-neutral-900 text-sm font-medium text-white">04</span>
            <h3 class="mb-3 text-lg font-medium text-neutral-900">Logistics</h3>
            <p class="text-sm leading-relaxed text-neutral-500">
              End-to-end supply chain control with in-house freight and delivery coordination.
            </p>
          </div>
        </div>
      </Container>
    </section>

    <!-- Sustainability -->
    <section class="bg-[#22384A] py-28 text-white md:py-36">
      <Container>
        <div class="grid gap-16 md:grid-cols-12 md:gap-8">
          <!-- Left: title & copy -->
          <div class="md:col-span-6">
            <p class="mb-6 text-[11px] font-medium tracking-[0.2em] uppercase text-white/40">
              Sustainability
            </p>
            <h2 class="mb-8 text-3xl font-medium leading-tight tracking-tight md:text-5xl">
              Lower impact, built into the process
            </h2>
            <p class="max-w-md text-base leading-relaxed text-white/60 md:text-lg">
              Sustainability is embedded across the supply chain, not treated as an add-on.
            </p>
          </div>

          <!-- Right: key initiatives -->
          <div class="flex flex-col justify-center md:col-span-5 md:col-start-8">
            <p class="mb-8 text-[11px] font-medium tracking-[0.2em] uppercase text-white/40">
              Key Initiatives
            </p>
            <ul class="space-y-6">
              <li class="flex items-start gap-4">
                <span class="mt-1 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-green-400/40 text-sm text-green-400">01</span>
                <span class="text-base font-medium text-white md:text-lg">Reduced carbon footprint production</span>
              </li>
              <li class="flex items-start gap-4">
                <span class="mt-1 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-green-400/40 text-sm text-green-400">02</span>
                <span class="text-base font-medium text-white md:text-lg">Recycled material garments (e.g. PET plastics)</span>
              </li>
              <li class="flex items-start gap-4">
                <span class="mt-1 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-green-400/40 text-sm text-green-400">03</span>
                <span class="text-base font-medium text-white md:text-lg">Transparent lifecycle tracking via QR codes</span>
              </li>
              <li class="flex items-start gap-4">
                <span class="mt-1 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-green-400/40 text-sm text-green-400">04</span>
                <span class="text-base font-medium text-white md:text-lg">Ethical manufacturing practices</span>
              </li>
            </ul>
          </div>
        </div>
      </Container>
    </section>

    <!-- CTA -->
    <section class="border-t border-neutral-200 py-24 md:py-32">
      <Container>
        <div class="flex flex-col items-center text-center">
          <h2 class="mb-4 text-2xl font-light text-neutral-800 md:text-3xl">
            Ready to get started?
          </h2>
          <p class="mb-8 max-w-md text-sm leading-relaxed text-neutral-500">
            Whether you're launching a new apparel line or sourcing custom
            homeware, we'll help you bring it to market responsibly.
          </p>
          <a href="/#contact" class="group inline-flex items-center overflow-hidden rounded-xl bg-neutral-900 text-white transition-opacity hover:opacity-90">
            <span class="px-6 py-4 text-sm font-medium tracking-wide uppercase">Get in Touch</span>
            <span class="flex h-full items-center border-l border-white/20 px-4 py-4">
              <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 3l5 5-5 5" /></svg>
            </span>
          </a>
        </div>
      </Container>
    </section>
  </main>

  <FooterContact />
</BaseLayout>
